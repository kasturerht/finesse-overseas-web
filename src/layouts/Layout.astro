---
import '../styles/global.css';
import Header from '../components/Header.astro';
import TopBar from '../components/TopBar.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  schema?: string;
}

const { title, description, canonical, image = '/germany-hero.avif', schema } = Astro.props;

// 🛡️ Silicon Valley Deterministic Canonical Generator
// Eliminates trailing-slash redirect loops and ensures 100% non-www consistency across Googlebot visits
const normalizeCanonical = (customCanonical?: string) => {
  if (customCanonical) {
    const cleaned = customCanonical.replace('www.finesseoverseas.com', 'finesseoverseas.com');
    return cleaned.replace(/\/+$/, '');
  }
  const cleanPath = Astro.url.pathname.replace(/\/+$/, '');
  return `https://finesseoverseas.com${cleanPath}`;
};

const canonicalURL = normalizeCanonical(canonical);
const ogImageURL = new URL(image, Astro.site).href;

const organizationSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Organization", "EducationalOrganization"],
      "@id": `${Astro.site}#organization`,
      "name": "Finesse Overseas Education",
      "url": String(Astro.site),
      "logo": {
        "@type": "ImageObject",
        "url": "https://finesseoverseas.com/logo.png",   // e.g. https://yoursite.com/logo.png
        "width": 200,
        "height": 60
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+91-9850069600",   // e.g. +91-XXXXXXXXXX
        "contactType": "customer service",
        "availableLanguage": ["English", "Hindi", "Marathi"]
      },
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Samarth Sakshi Plaza, First Floor, Above Sohala Showroom, Beside Lenskart, 4th Lane, Rajarampuri",
        "addressLocality": "Kolhapur",
        "postalCode": "416008",
        "addressRegion": "Maharashtra",
        "addressCountry": "IN"
      },
      "sameAs": [
        "https://maps.google.com/?cid=11646274483750008573",
        "https://www.justdial.com/Kolhapur/Finesse-Overseas-Education-Rajarampuri/0231PX231-X231-180327173117-F8R4_BZDET",
        "https://www.facebook.com/FinesseOverseasEducation",
        "https://www.instagram.com/finesseoverseaseducation/",
        "https://youtube.com/@finesseoverseaseducation1272?si=BCKfbpbBlf8PM86L"
      ]
    }
  ]
});
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- dataLayer must exist before GTM script executes -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
    </script>

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="Finesse Overseas Education" />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageURL} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" />
    </noscript>

    <!-- Schema injection: Render full page-specific graph if provided, otherwise fall back to default organization schema -->
    {schema ? (
      <script type="application/ld+json" set:html={schema} />
    ) : (
      <script type="application/ld+json" set:html={organizationSchema} />
    )}

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!--
      Lazy GTM loader — GTM is injected only on first user interaction.
      This eliminates GTM's render-blocking cost from initial page load
      while keeping full GTM functionality for real users.
      passive:true on scroll/touch ensures no jank on the main thread.
    -->
    <script is:inline>
      (function () {
        var GTM_ID = 'GTM-NB6773X9';
        var TRIGGER_EVENTS = ['scroll', 'mousemove', 'touchstart', 'keydown', 'click'];
        var loaded = false;

        function loadGTM() {
          if (loaded) return;
          loaded = true;

          TRIGGER_EVENTS.forEach(function (evt) {
            window.removeEventListener(evt, loadGTM);
          });

          window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });

          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtm.js?id=' + GTM_ID;
          document.head.appendChild(s);
        }

        TRIGGER_EVENTS.forEach(function (evt) {
          window.addEventListener(evt, loadGTM, { passive: true });
        });
      })();
    </script>
    <!-- 🌐 Silicon Valley Dual-Engine Meta Dataset (ID: 1655365958787346) -->
    <script is:inline>
      !(function (f, b, e, v, n, t, s) {
        if (f.fbq) return;
        n = f.fbq = function () {
          n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
        };
        if (!f._fbq) f._fbq = n;
        n.push = n;
        n.loaded = !0;
        n.version = '2.0';
        n.queue = [];
        t = b.createElement(e);
        t.async = !0;
        t.src = v;
        s = b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t, s);
      })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');

      fbq('init', '1655365958787346');
      fbq('track', 'PageView');

      // 🛡️ Universal Deduplicated Dual-Engine Meta Tracker (Browser + Serverless CAPI)
      window.finesseTrackMeta = function (eventName, userData, customData) {
        try {
          var eventId = (eventName || 'event').toLowerCase() + '_' + Date.now() + '_' + Math.random().toString(36).slice(2, 9);
          var uData = userData || {};
          var cData = customData || {};

          // 1. Fire Client-Side Meta Pixel with Event ID deduplication key
          if (typeof window.fbq === 'function') {
            window.fbq('track', eventName, cData, { eventID: eventId });
          }

          // 2. Dispatch to Server-Side Conversions API (Vercel Serverless Function)
          var payload = {
            event_name: eventName,
            event_id: eventId,
            event_source_url: window.location.href,
            user_data: {
              em: uData.em || uData.email,
              ph: uData.ph || uData.phone,
              fn: uData.fn || uData.name,
              ln: uData.ln
            },
            custom_data: cData
          };

          fetch('/api/meta-conversions', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
            keepalive: true
          }).catch(function (err) {
            console.warn('[Meta CAPI Client Dispatch Notice]:', err);
          });

          return eventId;
        } catch (e) {
          console.warn('[finesseTrackMeta error]:', e);
          return null;
        }
      };

      // 🎯 Silicon Valley First-Party FBC Cookie Preserver (Meta Parameter Builder Standard)
      try {
        var urlParams = new URLSearchParams(window.location.search);
        var fbclid = urlParams.get('fbclid');
        if (fbclid && !document.cookie.includes('_fbc=')) {
          var fbcVal = 'fb.1.' + Date.now() + '.' + fbclid;
          document.cookie = '_fbc=' + encodeURIComponent(fbcVal) + '; path=/; max-age=7776000; SameSite=Lax';
        }
      } catch (e) {}

      // Ensure subsequent client navigations fire PageView if using Astro page transitions
      document.addEventListener('astro:page-load', function () {
        if (typeof window.fbq === 'function') {
          window.fbq('track', 'PageView');
        }
      });
    </script>
  </head>

  <body class="font-inter bg-slate-50 text-slate-900 antialiased selection:bg-blue-600 selection:text-white">

    <!-- Meta Pixel noscript fallback -->
    <noscript>
      <img height="1" width="1" style="display:none"
        src="https://www.facebook.com/tr?id=1655365958787346&ev=PageView&noscript=1"
        alt=""
      />
    </noscript>

    <!-- GTM noscript fallback for users with JS disabled -->
    <noscript>
      <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NB6773X9"
        height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>

    <Header />
    <main>
      <slot />
    </main>

  </body>
</html>

<style is:global>
  :root {
    --accent: 13, 148, 136;
  }
  h1, h2, h3, h4, h5, h6 {
    font-family: 'Plus Jakarta Sans', sans-serif;
  }
</style>
