---
// src/components/Header.astro
---

<header class="fixed w-full top-0 z-50 transition-all duration-300 bg-white/85 backdrop-blur-md border-b border-slate-200/50 shadow-sm" id="navbar">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      
      <a href="/" class="flex-shrink-0 flex items-center transition-all hover:scale-105 group">
          <span class="sr-only">Finesse Overseas Logo</span>
          <img 
            src="/logo.png" 
            alt="Finesse Overseas Logo" 
            class="h-10 sm:h-14 w-auto object-contain shrink-0 
                   transition-all duration-300
                   drop-shadow-[0_4px_12px_rgba(20,184,166,0.25)]
                   group-hover:drop-shadow-[0_6px_16px_rgba(20,184,166,0.4)]" 
          />
      </a>

      {/* --- 🚀 DESKTOP NAVIGATION (High Visibility Update) --- */}
      <nav class="hidden md:flex gap-8 items-center">
        
        {/* Special Featured Link for MBBS Page */}
        <a href="/mbbs-India-abroad" class="group relative flex items-center gap-2 px-4 py-2 bg-teal-50 text-teal-700 rounded-lg border border-teal-100 hover:bg-teal-600 hover:text-white transition-all duration-300">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-teal-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-teal-500"></span>
          </span>
          <span class="text-[11px] font-black uppercase tracking-widest font-jakarta">MBBS Guide 2026</span>
        </a>

        {/* Silicon Valley Destinations Dropdown (Direct crawl links to all money hubs) */}
        <div class="relative group">
          <button 
            type="button" 
            class="text-sm font-bold text-slate-600 hover:text-teal-600 transition-colors inline-flex items-center gap-1.5 py-2 cursor-pointer focus:outline-none"
            aria-expanded="false"
          >
            <span>Destinations</span>
            <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-teal-600 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          
          <div class="absolute top-full -left-4 w-72 bg-white/95 backdrop-blur-xl border border-slate-200/90 rounded-2xl shadow-xl shadow-slate-900/10 p-2.5 opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 z-50">
            <a href="/study-in-germany" class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-slate-50 transition-colors group/item">
              <span class="w-8 h-8 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center shrink-0 font-bold text-xs mt-0.5 border border-blue-100">🇩🇪</span>
              <div class="flex flex-col">
                <span class="text-xs font-bold text-slate-900 group-hover/item:text-blue-600 transition-colors">Study in Germany</span>
                <span class="text-[11px] text-slate-500 font-normal">Zero Tuition Public Universities</span>
              </div>
            </a>
            <a href="/study-in-italy" class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-slate-50 transition-colors group/item">
              <span class="w-8 h-8 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center shrink-0 font-bold text-xs mt-0.5 border border-amber-100">🇮🇹</span>
              <div class="flex flex-col">
                <span class="text-xs font-bold text-slate-900 group-hover/item:text-amber-600 transition-colors">Study in Italy</span>
                <span class="text-[11px] text-slate-500 font-normal">100% Scholarship + DSU Grant</span>
              </div>
            </a>
            <a href="/study-in-austria" class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-slate-50 transition-colors group/item">
              <span class="w-8 h-8 rounded-lg bg-teal-50 text-teal-600 flex items-center justify-center shrink-0 font-bold text-xs mt-0.5 border border-teal-100">🇦🇹</span>
              <div class="flex flex-col">
                <span class="text-xs font-bold text-slate-900 group-hover/item:text-teal-600 transition-colors">Study in Austria</span>
                <span class="text-[11px] text-slate-500 font-normal">Zero Blocked Account Pathway</span>
              </div>
            </a>
            <a href="/study-in-uk-usa" class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-slate-50 transition-colors group/item">
              <span class="w-8 h-8 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center shrink-0 font-bold text-xs mt-0.5 border border-indigo-100">🇬🇧</span>
              <div class="flex flex-col">
                <span class="text-xs font-bold text-slate-900 group-hover/item:text-indigo-600 transition-colors">Study in UK & USA</span>
                <span class="text-[11px] text-slate-500 font-normal">1-Yr Masters & 3-Yr STEM OPT</span>
              </div>
            </a>
            <div class="border-t border-slate-100 mt-1 pt-1.5">
              <a href="/study-abroad-consultants-in-kolhapur" class="flex items-center justify-between p-2 rounded-xl bg-slate-50/80 hover:bg-teal-50 text-slate-700 hover:text-teal-700 transition-colors text-[11px] font-bold">
                <span>📍 Kolhapur Counseling HQ</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </div>

        <a href="/#services" class="text-sm font-bold text-slate-600 hover:text-teal-600 transition-colors">Services</a>
        
        {/* Sleek, premium link for Blogs/Audits with subtle hover effect */}
        <a href="/intelligence" class="text-sm font-bold text-slate-600 hover:text-teal-600 transition-all duration-300 flex items-center gap-1.5 group relative">
          <span>Audit Vault</span>
          <span class="inline-flex h-1.5 w-1.5 rounded-full bg-emerald-500 group-hover:scale-150 transition-all duration-300 shadow-[0_0_8px_rgba(16,185,129,0.6)]"></span>
        </a>

        <a href="/#faq" class="text-sm font-bold text-slate-600 hover:text-teal-600 transition-colors">FAQ</a>
        
        <a href="/contact" onclick="window.dataLayer = window.dataLayer || []; window.dataLayer.push({'event': 'Contact_Click', 'contact_type': 'book_counseling', 'location': 'header_desktop'});" class="relative z-20 bg-slate-900 hover:bg-teal-600 text-white px-6 py-2.5 rounded-full text-sm font-bold transition-all duration-300 shadow-md hover:shadow-lg hover:-translate-y-0.5 ml-2">
          Book Free Counseling
        </a>
      </nav>

      <button id="mobile-menu-btn" class="md:hidden text-slate-800 focus:outline-none p-2 rounded-lg hover:bg-slate-50 transition-colors" aria-label="Toggle Menu">
        <svg id="menu-icon" class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path></svg>
        <svg id="close-icon" class="w-7 h-7 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>

    </div>
  </div>

  {/* --- 📱 MOBILE MENU (High Visibility Update) --- */}
  <div id="mobile-menu" class="hidden md:hidden bg-white/95 backdrop-blur-xl border-t border-slate-100 absolute w-full shadow-2xl origin-top transition-all duration-300 ease-out transform opacity-0 -translate-y-4 scale-y-95 rounded-b-3xl pointer-events-none">
    <div class="px-5 pt-6 pb-8 space-y-3 flex flex-col">
      
      {/* Primary Mobile Call-to-Action for MBBS */}
      <a href="/mbbs-India-abroad" class="mobile-link group flex flex-col gap-1 px-5 py-5 bg-gradient-to-r from-teal-600 to-teal-700 rounded-2xl shadow-lg shadow-teal-600/20 transition-all active:scale-95">
        <div class="flex items-center justify-between">
          <span class="text-xs font-black text-teal-100 uppercase tracking-widest">New for 2026</span>
          <span class="w-2 h-2 rounded-full bg-white animate-pulse"></span>
        </div>
        <span class="text-lg font-extrabold text-white">MBBS Admission Blueprint</span>
        <span class="text-[10px] text-teal-100/80 font-medium">India vs Abroad Comparison Guide</span>
      </a>

      {/* Mobile Destinations Submenu (Direct crawlable pathways) */}
      <div class="px-2 py-3 bg-slate-50/80 rounded-2xl border border-slate-100 flex flex-col gap-1">
        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest px-3 py-1">Top Pathways</span>
        <div class="grid grid-cols-2 gap-1.5 px-1">
          <a href="/study-in-germany" class="mobile-link flex items-center gap-2 p-2 rounded-xl bg-white hover:bg-teal-50 border border-slate-100 text-xs font-bold text-slate-800 transition-colors">
            <span>🇩🇪</span>
            <span>Germany</span>
          </a>
          <a href="/study-in-italy" class="mobile-link flex items-center gap-2 p-2 rounded-xl bg-white hover:bg-teal-50 border border-slate-100 text-xs font-bold text-slate-800 transition-colors">
            <span>🇮🇹</span>
            <span>Italy</span>
          </a>
          <a href="/study-in-austria" class="mobile-link flex items-center gap-2 p-2 rounded-xl bg-white hover:bg-teal-50 border border-slate-100 text-xs font-bold text-slate-800 transition-colors">
            <span>🇦🇹</span>
            <span>Austria</span>
          </a>
          <a href="/study-in-uk-usa" class="mobile-link flex items-center gap-2 p-2 rounded-xl bg-white hover:bg-teal-50 border border-slate-100 text-xs font-bold text-slate-800 transition-colors">
            <span>🇬🇧</span>
            <span>UK & USA</span>
          </a>
        </div>
        <a href="/study-abroad-consultants-in-kolhapur" class="mobile-link mx-1 mt-1 flex items-center justify-between p-2 rounded-xl bg-teal-500/10 text-teal-800 text-xs font-bold hover:bg-teal-500/20 transition-colors">
          <span>📍 Rajarampuri, Kolhapur HQ</span>
          <span>→</span>
        </a>
      </div>

      <a href="/#services" class="mobile-link group flex items-center gap-4 px-4 py-4 text-lg font-medium text-slate-700 hover:bg-slate-50 hover:text-teal-600 rounded-2xl transition-all">
        <span class="w-12 h-12 bg-slate-50 text-slate-400 group-hover:bg-teal-50 group-hover:text-teal-500 rounded-xl flex items-center justify-center shrink-0 border border-slate-100 transition-colors">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
        </span>
        Our Blueprint
      </a>

      {/* Premium Mobile Card for Audit Vault */}
      <a href="/intelligence" class="mobile-link group flex items-center gap-4 px-4 py-4 text-lg font-medium text-slate-700 hover:bg-slate-50 hover:text-emerald-600 rounded-2xl transition-all">
        <span class="w-12 h-12 bg-slate-50 text-slate-400 group-hover:bg-emerald-50 group-hover:text-emerald-500 rounded-xl flex items-center justify-center shrink-0 border border-slate-100 transition-colors">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
        </span>
        <div class="flex flex-col text-left">
          <span class="text-lg font-bold text-slate-700 group-hover:text-emerald-600 transition-colors">The Audit Vault</span>
          <span class="text-[10px] text-slate-400 font-medium">Unfiltered Research & Truths</span>
        </div>
      </a>
      
      <div class="pt-4 mt-2 border-t border-slate-100">
        <a href="/contact" onclick="window.dataLayer = window.dataLayer || []; window.dataLayer.push({'event': 'Contact_Click', 'contact_type': 'book_counseling', 'location': 'header_mobile'});" class="mobile-link relative z-20 flex justify-center items-center gap-2 w-full bg-slate-900 hover:bg-slate-800 text-white px-6 py-4 rounded-xl text-lg font-semibold transition-all shadow-md active:scale-95">
          Book Free Counseling
          <svg class="w-5 h-5 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
        </a>
      </div>
      
    </div>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const menuIcon = document.getElementById('menu-icon');
    const closeIcon = document.getElementById('close-icon');
    const mobileLinks = document.querySelectorAll('.mobile-link');
    
    let isOpen = false;
    let isTransitioning = false;

    if (!btn || !menu || !menuIcon || !closeIcon) return;

    function openMenu() {
      if (isOpen || isTransitioning) return;
      isTransitioning = true;
      isOpen = true;

      // Toggle hamburger menu icons
      menuIcon.classList.add('hidden');
      closeIcon.classList.remove('hidden');

      // Make the container active in the DOM layout
      menu.classList.remove('hidden');
      
      // Request an animation frame to trigger the hardware-accelerated transition
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          menu.classList.remove('opacity-0', '-translate-y-4', 'scale-y-95', 'pointer-events-none');
          menu.classList.add('opacity-100', 'translate-y-0', 'scale-y-100', 'pointer-events-auto');
        });
      });

      // Seamlessly lock background document scrolling
      document.body.style.overflow = 'hidden';

      setTimeout(() => {
        isTransitioning = false;
      }, 300);
    }

    function closeMenu() {
      if (!isOpen || isTransitioning) return;
      isTransitioning = true;
      isOpen = false;

      // Reset menu icons
      menuIcon.classList.remove('hidden');
      closeIcon.classList.add('hidden');

      // Transition out gracefully
      menu.classList.remove('opacity-100', 'translate-y-0', 'scale-y-100', 'pointer-events-auto');
      menu.classList.add('opacity-0', '-translate-y-4', 'scale-y-95', 'pointer-events-none');

      // Restore scrolling to the body
      document.body.style.overflow = '';

      setTimeout(() => {
        // Remove from DOM render tree only after exit transition completes
        if (!isOpen) {
          menu.classList.add('hidden');
        }
        isTransitioning = false;
      }, 300);
    }

    // Toggle click event
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    // Close menu when clicking on any mobile navigation link
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        closeMenu();
      });
    });

    // Auto-close menu if a click occurs outside of the active menu or header
    document.addEventListener('click', (e) => {
      if (isOpen && !menu.contains(e.target as Node) && !btn.contains(e.target as Node)) {
        closeMenu();
      }
    });
  });
</script>