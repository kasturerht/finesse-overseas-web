---
interface Props {
  renderSchema?: boolean;
}

const { renderSchema = true } = Astro.props;

export const faqs = [
  {
    question: "Is education really free in Germany for international students?",
    answer: "Yes. In 16 German federal states, public universities charge €0 tuition fees for Bachelor's and Master's degrees. Students only pay a minor administrative semester fee (€150 - €350) which typically includes a regional public transit pass."
  },
  {
    question: "How does the 100% Scholarship in Italy (DSU / ISEE Parificato) work?",
    answer: "Italy provides regional need-based scholarships (DSU) based on family income calculated via the ISEE Parificato document. Eligible Indian students receive a 100% tuition waiver, free university dining, student housing access, and an annual cash stipend of up to €7,400 to €8,000."
  },
  {
    question: "What are the mandatory NMC FMGL 2021 rules for MBBS Abroad?",
    answer: "Under the National Medical Commission (NMC) FMGL Regulations 2021, foreign medical degrees must feature a minimum 54-month theoretical course, 12 months of integrated internship at the same institution, 100% English instruction medium, and confer a valid license to practice in the awarding country."
  },
  {
    question: "Can Indian students study in Austria without a Blocked Account?",
    answer: "Yes! Unlike Germany, Austrian public universities do not mandate a German-style blocked account upfront. Tuition fees are highly subsidized at approximately €736 per semester, making Austria one of Europe's most economical English-taught study destinations."
  },
  {
    question: "What is an APS Certificate and why is it mandatory for Germany?",
    answer: "The APS (Akademische Prüfstelle) certificate issued by the German Embassy in New Delhi verifies the authenticity of Indian academic credentials. It is a compulsory prerequisite for German student visa applications and Uni-Assist university admissions."
  },
  {
    question: "Do I need to speak German or Italian to study in Europe?",
    answer: "No. All programs recommended by Finesse are 100% taught in English. However, learning foundational local language (A1/A2 level) is strongly recommended for seamless daily living, student part-time jobs, and post-study career integration."
  },
  {
    question: "What is the Blocked Account (Sperrkonto) requirement for Germany in 2026?",
    answer: "For a German student visa in 2026, students deposit €11,208 into a regulated blocked account (such as Expatrio or Fintiba). This remains the student's personal money, paid back automatically in monthly installments of €934 for living expenses."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<section class="py-24 bg-slate-50 relative overflow-hidden" id="faq">
  {renderSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <div class="absolute top-0 right-0 -mt-20 -mr-20 w-96 h-96 bg-teal-400/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 -mb-20 -ml-20 w-80 h-80 bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      
      <div class="lg:col-span-5 lg:sticky lg:top-32">
        <span class="inline-block px-4 py-1.5 rounded-full bg-teal-100 text-teal-700 font-bold tracking-wider uppercase mb-6 text-xs shadow-sm">Clear Your Doubts</span>
        <h2 class="text-4xl md:text-5xl font-extrabold text-slate-900 mb-6 tracking-tight leading-tight">Got Questions?<br/><span class="text-teal-600">We've Got Answers.</span></h2>
        <p class="text-lg text-slate-600 mb-8 leading-relaxed">Everything you need to know before starting your European education journey. Can't find what you're looking for?</p>
        
        <div class="bg-white p-6 rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-slate-100 flex items-center gap-5 hover:border-teal-200 transition-colors group">
          <div class="w-14 h-14 bg-teal-50 rounded-full flex items-center justify-center text-teal-600 shrink-0 group-hover:bg-teal-500 group-hover:text-white transition-colors">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
          </div>
          <div>
            <h4 class="font-bold text-slate-900 text-lg">Still have doubts?</h4>
            <a href="/contact" class="relative z-20 text-teal-600 font-bold text-sm hover:text-teal-700 flex items-center mt-1">
              Talk to our experts 
              <svg class="w-4 h-4 ml-1 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
            </a>
          </div>
        </div>
      </div>

      <div class="lg:col-span-7 space-y-5">
        {faqs.map((faq) => (
          <div class="faq-item group bg-white border border-slate-100 rounded-2xl overflow-hidden transition-all duration-300 shadow-sm hover:shadow-xl hover:-translate-y-1 hover:border-teal-200">
            <button 
              class="faq-button w-full px-6 md:px-8 py-6 text-left flex justify-between items-center focus:outline-none"
              aria-expanded="false"
            >
              <span class="text-lg font-bold text-slate-800 pr-8 group-hover:text-teal-600 transition-colors">{faq.question}</span>
              <span class="faq-icon relative shrink-0 w-10 h-10 rounded-full bg-slate-50 border border-slate-200 flex items-center justify-center text-slate-500 transition-all duration-500 group-hover:bg-teal-50 group-hover:text-teal-600 group-hover:border-teal-200">
                <svg class="w-5 h-5 transition-transform duration-500 transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"></path></svg>
              </span>
            </button>
            
            <div class="faq-answer grid grid-rows-[0fr] transition-all duration-500 ease-in-out opacity-50">
              <div class="overflow-hidden">
                <p class="px-6 md:px-8 pb-6 text-slate-600 leading-relaxed font-medium">
                  {faq.answer}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>

<script>
  const initFaqs = () => {
    const faqItems = document.querySelectorAll('.faq-item');

    faqItems.forEach(item => {
      const button = item.querySelector('.faq-button');
      const answer = item.querySelector('.faq-answer');
      const icon = item.querySelector('.faq-icon');
      const iconSvg = icon?.querySelector('svg');

      if (button && answer && icon && iconSvg) {
        button.addEventListener('click', () => {
          const isExpanded = button.getAttribute('aria-expanded') === 'true';
          
          // Auto-close others
          faqItems.forEach(otherItem => {
            if (otherItem !== item) {
              const otherBtn = otherItem.querySelector('.faq-button');
              const otherAns = otherItem.querySelector('.faq-answer');
              const otherIc = otherItem.querySelector('.faq-icon');
              const otherSvg = otherIc?.querySelector('svg');
              
              if (otherBtn && otherAns && otherIc && otherSvg) {
                otherBtn.setAttribute('aria-expanded', 'false');
                otherAns.classList.remove('grid-rows-[1fr]', 'opacity-100');
                otherAns.classList.add('grid-rows-[0fr]', 'opacity-50');
                otherIc.classList.remove('bg-teal-500', 'text-white', 'border-teal-500');
                otherSvg.classList.remove('rotate-45');
                otherItem.classList.remove('border-teal-500', 'shadow-md');
              }
            }
          });

          // Toggle Current
          button.setAttribute('aria-expanded', (!isExpanded).toString());
          
          if (!isExpanded) {
            answer.classList.remove('grid-rows-[0fr]', 'opacity-50');
            answer.classList.add('grid-rows-[1fr]', 'opacity-100');
            icon.classList.add('bg-teal-500', 'text-white', 'border-teal-500');
            iconSvg.classList.add('rotate-45'); // Magic trick: '+' becomes 'x'
            item.classList.add('border-teal-500', 'shadow-md');
          } else {
            answer.classList.remove('grid-rows-[1fr]', 'opacity-100');
            answer.classList.add('grid-rows-[0fr]', 'opacity-50');
            icon.classList.remove('bg-teal-500', 'text-white', 'border-teal-500');
            iconSvg.classList.remove('rotate-45');
            item.classList.remove('border-teal-500', 'shadow-md');
          }
        });
      }
    });
  };

  initFaqs();
  document.addEventListener('astro:after-swap', initFaqs);
</script>