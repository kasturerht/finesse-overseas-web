---
// src/components/RedNoticeAlert.astro
// 👑 THE CONVERSION ENGINE: VIP Regulatory Red Notice Alert & Dispatch Box
---

<section class="w-full py-16 lg:py-24 bg-slate-950 relative z-20 border-t border-slate-900 font-sans" id="red-notice-alert-section">
  <div class="container mx-auto px-4 lg:px-8 max-w-5xl">
    
    <div class="relative bg-gradient-to-br from-rose-950/80 via-slate-900 to-slate-950 border border-rose-500/30 rounded-3xl p-8 md:p-12 lg:p-14 overflow-hidden shadow-2xl">
      
      <div class="absolute -top-24 -right-24 w-64 h-64 bg-rose-600/15 blur-[90px] rounded-full pointer-events-none"></div>
      <div class="absolute -bottom-24 -left-24 w-64 h-64 bg-rose-800/15 blur-[90px] rounded-full pointer-events-none"></div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-14 items-center relative z-10">
        
        <!-- Left Side: Copy & Trust -->
        <div>
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-rose-500/10 border border-rose-500/30 text-[10px] font-mono font-bold uppercase tracking-widest text-rose-400 mb-6 shadow-sm">
            <span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse shadow-[0_0_8px_rgba(225,29,72,0.8)]"></span>
            Statutory Intelligence Bulletin
          </div>
          
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-serif text-white font-medium leading-[1.2] tracking-tight mb-4">
            Agents won't notify you when the <span class="text-transparent bg-clip-text bg-gradient-to-r from-rose-400 to-rose-200 font-semibold italic">gazette changes.</span>
          </h2>
          
          <p class="text-slate-300 text-sm md:text-base font-normal leading-relaxed mb-8">
            Receive unedited statutory gazette updates, university blacklist notifications, and tuition hike alerts directly to your WhatsApp.
          </p>
          
          <div class="flex items-center gap-4 border-t border-slate-800 pt-6">
            <div class="flex -space-x-2.5">
              <div class="w-9 h-9 rounded-full border-2 border-slate-900 bg-emerald-700 flex items-center justify-center text-xs font-bold text-white">R</div>
              <div class="w-9 h-9 rounded-full border-2 border-slate-900 bg-blue-700 flex items-center justify-center text-xs font-bold text-white">S</div>
              <div class="w-9 h-9 rounded-full border-2 border-slate-900 bg-amber-700 flex items-center justify-center text-xs font-bold text-white">A</div>
            </div>
            <div>
              <p class="text-white text-xs font-bold tracking-wide">5,200+ Parents Subscribed</p>
              <p class="text-emerald-400 text-[10px] font-mono uppercase tracking-widest mt-0.5">100% Free • Verified Data</p>
            </div>
          </div>
        </div>

        <!-- Right Side: Form -->
        <div class="bg-slate-900/90 backdrop-blur-md border border-slate-800 p-6 md:p-8 rounded-2xl shadow-xl">
          <form id="red-notice-form" class="flex flex-col gap-4">
            
            <div class="flex flex-col gap-1.5">
              <label for="parentName" class="text-[11px] font-mono font-bold uppercase tracking-wider text-slate-400">Parent / Student Full Name</label>
              <div class="relative">
                <input 
                  type="text" 
                  id="parentName" 
                  placeholder="e.g. Dr. Rajesh Kulkarni" 
                  class="w-full bg-slate-950 border border-slate-700/80 rounded-xl pl-10 pr-4 py-3 text-white text-sm focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-all placeholder:text-slate-600 font-sans" 
                  required 
                />
                <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
              </div>
            </div>

            <div class="flex flex-col gap-1.5">
              <label for="whatsappNum" class="text-[11px] font-mono font-bold uppercase tracking-wider text-slate-400">WhatsApp Contact Number</label>
              <div class="relative">
                <input 
                  type="tel" 
                  id="whatsappNum" 
                  placeholder="+91 98765 43210" 
                  class="w-full bg-slate-950 border border-slate-700/80 rounded-xl pl-10 pr-4 py-3 text-white text-sm focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-all placeholder:text-slate-600 font-sans" 
                  required 
                />
                <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-emerald-500" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.48 2 2 6.48 2 12c0 1.76.46 3.4 1.25 4.85L2 22l5.31-1.22A9.974 9.974 0 0012 22c5.52 0 10-4.48 10-10S17.52 2 12 2zm5.45 14.5c-.24.67-1.39 1.28-1.92 1.35-.5.06-1.15.15-3.32-.75-2.61-1.08-4.29-3.75-4.42-3.92-.13-.17-1.05-1.41-1.05-2.69 0-1.28.66-1.91.89-2.15.22-.24.49-.3.65-.3.17 0 .33 0 .48.01.16.01.38-.06.58.42.21.51.72 1.78.78 1.91.06.13.1.28.02.45-.08.17-.12.28-.24.42-.12.14-.25.32-.36.43-.13.14-.26.3-.11.56.15.26.68 1.13 1.47 1.83.99.89 1.83 1.16 2.09 1.3.26.14.41.12.56-.05.15-.17.65-.75.82-1.01.17-.26.34-.22.58-.13.24.09 1.53.72 1.8 86.26.13.38.19.58.28.89.09z"/></svg>
              </div>
            </div>

            <button 
              type="submit" 
              class="w-full bg-rose-600 hover:bg-rose-500 text-white text-xs font-bold uppercase tracking-widest py-3.5 rounded-xl transition-all shadow-lg shadow-rose-600/30 mt-2 flex items-center justify-center gap-2 group cursor-pointer"
            >
              Subscribe To Regulatory Red Notices
              <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
            </button>
            
            <p class="text-center text-[10px] font-mono text-slate-500 mt-1">
              Strict privacy. Zero spam. Official alerts only.
            </p>
          </form>
        </div>

      </div>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const redNoticeForm = document.getElementById('red-notice-form');
    if (redNoticeForm) {
      redNoticeForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const name = document.getElementById('parentName')?.value;
        const phone = document.getElementById('whatsappNum')?.value;
        
        if (typeof window !== 'undefined' && window.dataLayer) {
          window.dataLayer.push({
            event: 'red_notice_subscription',
            subscriber_name: name,
            subscriber_phone: phone
          });
        }

        alert('Thank you! You have been successfully enrolled in the Finesse Sovereign Red Notice Dispatch.');
        redNoticeForm.reset();
      });
    }
  });
</script>