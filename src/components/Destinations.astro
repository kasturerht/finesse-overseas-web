---
// src/components/Destinations.astro
// 👑 SWISS-LUXURY UNIFIED ADMISSION PATHWAYS & 2026 FACT ENGINE
// Consolidates Visual Navigation + Audited AEO Facts into a Single Apple-Grade Hub

const destinations = [
  { 
    id: "germany",
    name: "Germany", 
    ctaText: "Explore Germany",
    flagType: "germany",
    badge: "Zero Tuition Fee",
    badgeTheme: "bg-blue-50 text-blue-700 border-blue-200/80 shadow-[0_2px_10px_rgba(37,99,235,0.08)]",
    hook: "World-class engineering & masters at 0 tuition cost across 380+ public universities.", 
    link: "/study-in-germany",
    isPopular: true,
    accentBorder: "hover:border-blue-300",
    accentShadow: "hover:shadow-[0_20px_40px_-15px_rgba(37,99,235,0.15)]",
    accentBlob: "bg-blue-500/10",
    titleHover: "group-hover:text-blue-600",
    dotColor: "bg-blue-500",
    btnTheme: "bg-blue-50/70 border-blue-200 text-blue-700 group-hover:bg-blue-600 group-hover:text-white group-hover:border-blue-600 shadow-sm",
    metrics: [
      { label: "Tuition Fee", value: "€0 across 16 Federal States" },
      { label: "Blocked Account", value: "€11,208/yr (€934/mo payout)" },
      { label: "APS Protocol", value: "Mandatory Embassy Verification" },
      { label: "Post-Study Visa", value: "18-Month Job Seeker Visa" }
    ]
  },
  { 
    id: "italy",
    name: "Italy", 
    ctaText: "Explore Italy",
    flagType: "italy",
    badge: "100% Scholarship",
    badgeTheme: "bg-amber-50 text-amber-700 border-amber-200/80 shadow-[0_2px_10px_rgba(245,158,11,0.08)]",
    hook: "100% tuition waiver + annual cash stipend for living expenses via regional DSU grant.", 
    link: "/study-in-italy",
    isPopular: true,
    accentBorder: "hover:border-amber-300",
    accentShadow: "hover:shadow-[0_20px_40px_-15px_rgba(245,158,11,0.15)]",
    accentBlob: "bg-amber-500/10",
    titleHover: "group-hover:text-amber-600",
    dotColor: "bg-amber-500",
    btnTheme: "bg-amber-50/70 border-amber-200 text-amber-700 group-hover:bg-amber-600 group-hover:text-white group-hover:border-amber-600 shadow-sm",
    metrics: [
      { label: "Tuition Waiver", value: "100% Free Tuition via DSU Grant" },
      { label: "Annual Stipend", value: "Up to €7,400 to €8,000 / Year" },
      { label: "Evaluation", value: "ISEE Parificato Family Income" },
      { label: "Instruction Medium", value: "100% English-Taught Degrees" }
    ]
  },
  { 
    id: "austria",
    name: "Austria", 
    ctaText: "Explore Austria",
    flagType: "austria",
    badge: "Zero Blocked A/C",
    badgeTheme: "bg-teal-50 text-teal-700 border-teal-200/80 shadow-[0_2px_10px_rgba(20,184,166,0.08)]",
    hook: "Subsidized European public degrees with zero mandatory blocked account hassles.", 
    link: "/study-in-austria",
    isPopular: false,
    accentBorder: "hover:border-teal-300",
    accentShadow: "hover:shadow-[0_20px_40px_-15px_rgba(20,184,166,0.15)]",
    accentBlob: "bg-teal-500/10",
    titleHover: "group-hover:text-teal-600",
    dotColor: "bg-teal-500",
    btnTheme: "bg-teal-50/70 border-teal-200 text-teal-700 group-hover:bg-teal-600 group-hover:text-white group-hover:border-teal-600 shadow-sm",
    metrics: [
      { label: "Semester Fee", value: "Approx. €736 / Semester" },
      { label: "Blocked Account", value: "No Mandatory Sperrkonto" },
      { label: "Living Standard", value: "Vienna #1 Global Quality of Life" },
      { label: "Work Rights", value: "20 Hours / Week Part-Time" }
    ]
  },
  { 
    id: "mbbs-abroad",
    name: "MBBS in Europe", 
    ctaText: "Explore MBBS Abroad",
    flagType: "mbbs",
    badge: "100% NMC Compliant",
    badgeTheme: "bg-emerald-50 text-emerald-700 border-emerald-200/80 shadow-[0_2px_10px_rgba(16,185,129,0.08)]",
    hook: "Legally verified European medical degree at 1/4th the cost of Indian private colleges.", 
    link: "/mbbs-India-abroad",
    isPopular: true,
    accentBorder: "hover:border-emerald-300",
    accentShadow: "hover:shadow-[0_20px_40px_-15px_rgba(16,185,129,0.15)]",
    accentBlob: "bg-emerald-500/10",
    titleHover: "group-hover:text-emerald-600",
    dotColor: "bg-emerald-500",
    btnTheme: "bg-emerald-50/70 border-emerald-200 text-emerald-700 group-hover:bg-emerald-600 group-hover:text-white group-hover:border-emerald-600 shadow-sm",
    metrics: [
      { label: "Total 6-Yr Budget", value: "₹20 – ₹35 Lakhs Total" },
      { label: "Course Structure", value: "54 Months + 12 Mo Internship" },
      { label: "Licensing Sync", value: "100% NMC FMGL 2021 Compliant" },
      { label: "Eligibility", value: "NEET Qualified (No high cutoff)" }
    ]
  }
];
---

<section class="py-24 bg-slate-50 relative overflow-hidden" id="destinations">
  <!-- Subtle ambient glow background -->
  <div class="absolute top-0 right-1/4 w-96 h-96 bg-teal-400/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-0 left-1/4 w-96 h-96 bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-slate-200/80 text-teal-700 text-xs font-bold uppercase tracking-wider mb-4 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-teal-500 animate-pulse"></span>
        2026 Sovereign Admission Pathways
      </div>
      <h2 class="text-3xl md:text-5xl font-extrabold text-slate-900 mb-4 tracking-tight">
        Where Do You Want to Study? <br class="hidden md:block" />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-600 to-blue-600">Verified European Blueprints</span>
      </h2>
      <p class="text-base md:text-lg text-slate-600 max-w-2xl mx-auto font-normal leading-relaxed">
        Audited financial & legal parameters for Indian students. Zero commission-driven hype — 100% public universities and statutory compliance.
      </p>
    </div>

    <!-- 4-Card Luxury Unified Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-7 items-stretch">
      {destinations.map((dest) => (
        <div class={`relative bg-white rounded-3xl p-7 border border-slate-200/90 shadow-sm hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between group overflow-hidden ${dest.accentShadow} ${dest.accentBorder}`}>
          
          {/* Subtle Corner Glow */}
          {dest.isPopular && (
            <div class={`absolute top-0 right-0 w-28 h-28 rounded-bl-full -mr-6 -mt-6 transition-transform group-hover:scale-125 duration-500 pointer-events-none ${dest.accentBlob}`}></div>
          )}

          <div class="relative z-10 flex flex-col flex-grow">
            {/* Header / Badge Row with SVG Flag */}
            <div class="flex items-center justify-between mb-4">
              <div class="shrink-0">
                {dest.flagType === 'germany' && (
                  <svg class="w-7 h-5 rounded shadow-sm border border-slate-200/70 overflow-hidden" viewBox="0 0 5 3">
                    <rect width="5" height="1" y="0" fill="#1e293b"/>
                    <rect width="5" height="1" y="1" fill="#dc2626"/>
                    <rect width="5" height="1" y="2" fill="#eab308"/>
                  </svg>
                )}
                {dest.flagType === 'italy' && (
                  <svg class="w-7 h-5 rounded shadow-sm border border-slate-200/70 overflow-hidden" viewBox="0 0 3 2">
                    <rect width="1" height="2" x="0" fill="#16a34a"/>
                    <rect width="1" height="2" x="1" fill="#ffffff"/>
                    <rect width="1" height="2" x="2" fill="#dc2626"/>
                  </svg>
                )}
                {dest.flagType === 'austria' && (
                  <svg class="w-7 h-5 rounded shadow-sm border border-slate-200/70 overflow-hidden" viewBox="0 0 3 2">
                    <rect width="3" height="0.67" y="0" fill="#dc2626"/>
                    <rect width="3" height="0.67" y="0.67" fill="#ffffff"/>
                    <rect width="3" height="0.67" y="1.34" fill="#dc2626"/>
                  </svg>
                )}
                {dest.flagType === 'mbbs' && (
                  <div class="w-7 h-5 rounded bg-emerald-600 text-white flex items-center justify-center shadow-sm">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/>
                    </svg>
                  </div>
                )}
              </div>
              <span class={`inline-block px-3 py-1 text-[10px] font-black uppercase tracking-widest rounded-full border ${dest.badgeTheme}`}>
                {dest.badge}
              </span>
            </div>

            {/* Destination Title */}
            <h3 class={`text-2xl font-black text-slate-900 tracking-tight transition-colors mb-2.5 ${dest.titleHover}`}>
              {dest.name}
            </h3>
            
            {/* Value Hook with Min Height for Uniform Symmetry */}
            <p class="text-slate-600 font-normal text-xs leading-relaxed mb-6 min-h-[36px]">
              {dest.hook}
            </p>
            
            {/* Audited Metrics Box (Clean Stacked Key-Value List) */}
            <div class="bg-slate-50/90 rounded-2xl p-4 border border-slate-100 mb-6 space-y-3 flex-grow">
              {dest.metrics.map((metric) => (
                <div class="flex items-start gap-2.5 text-xs">
                  <div class={`w-1.5 h-1.5 rounded-full mt-1.5 shrink-0 ${dest.dotColor}`}></div>
                  <div class="leading-tight">
                    <span class="text-slate-400 font-bold uppercase tracking-wider text-[9.5px] block mb-0.5">{metric.label}</span>
                    <span class="font-bold text-slate-800 text-xs block">{metric.value}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
          
          {/* Action Button */}
          <div class="relative z-10 pt-2">
            <a 
              href={dest.link} 
              data-track="destination-card-click" 
              data-destination={dest.name} 
              class={`w-full flex items-center justify-between px-5 py-3.5 rounded-xl font-bold text-xs transition-all duration-300 border ${dest.btnTheme}`}
            >
              <span>{dest.ctaText}</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Official Regulatory Citations Strip (AEO & AI Discovery Footer) -->
    <div class="mt-12 p-4.5 bg-white/80 backdrop-blur-md rounded-2xl border border-slate-200/80 text-center text-xs text-slate-500 font-medium shadow-sm flex flex-col sm:flex-row items-center justify-center gap-2">
      <span class="font-bold text-slate-700 inline-flex items-center gap-1.5">
        <svg class="w-4 h-4 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        Official Statutory References:
      </span>
      <span>National Medical Commission (NMC Gazette 2021) • DAAD German Academic Exchange Service • Akademische Prüfstelle (APS New Delhi) • Ministero degli Affari Esteri (Italy DSU).</span>
    </div>

  </div>
</section>