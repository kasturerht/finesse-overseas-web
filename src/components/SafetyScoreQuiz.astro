---
// src/components/SafetyScoreQuiz.astro
// 👑 THE MASTERPIECE DIAGNOSTIC TERMINAL: Interactive NMC Compliance & Clinical Safety Engine
---

<section class="relative w-full py-20 lg:py-28 bg-slate-950 text-white font-sans overflow-hidden" id="safety-quiz-section">
  
  <!-- Subtle Ambient Glows -->
  <div class="absolute top-1/3 left-0 -translate-y-1/2 w-96 h-96 bg-emerald-500/10 blur-[120px] rounded-full pointer-events-none"></div>
  <div class="absolute bottom-0 right-0 w-[500px] h-[500px] bg-blue-500/10 blur-[140px] rounded-full pointer-events-none"></div>

  <div class="container mx-auto px-4 lg:px-8 max-w-7xl relative z-10">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Left Column: Copy & Authority Badges (5 Cols) -->
      <div class="lg:col-span-5 text-center lg:text-left">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-900 border border-emerald-500/30 text-[10px] font-mono font-bold uppercase tracking-widest text-emerald-400 mb-6 shadow-lg">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          Statutory Verification Matrix
        </div>
        
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif text-white font-medium leading-[1.15] tracking-tight mb-6">
          Is your agent pitching a <br class="hidden lg:block"/>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-rose-400 via-amber-300 to-rose-200 font-semibold italic">Non-Compliant University?</span>
        </h2>
        
        <p class="text-slate-300 text-base sm:text-lg font-normal leading-relaxed mb-8 max-w-xl mx-auto lg:mx-0">
          Do not rely on unverified PDF brochures. Run any medical or technical university through our statutory 3-point NMC Gazette filtration matrix to verify legal safety before transferring fees.
        </p>
        
        <div class="grid grid-cols-2 gap-6 border-t border-slate-800 pt-6 max-w-md mx-auto lg:mx-0">
          <div>
            <div class="text-2xl lg:text-3xl font-serif font-bold text-white">15,000+</div>
            <p class="text-[11px] text-slate-400 uppercase tracking-wider font-mono mt-1">Universities Audited</p>
          </div>
          <div>
            <div class="text-2xl lg:text-3xl font-serif font-bold text-emerald-400">100%</div>
            <p class="text-[11px] text-slate-400 uppercase tracking-wider font-mono mt-1">NMC 2021 Gazette Alignment</p>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Diagnostic Terminal (7 Cols) -->
      <div class="lg:col-span-7">
        <div class="bg-slate-900/90 backdrop-blur-xl border border-slate-800 rounded-3xl p-6 sm:p-8 lg:p-10 shadow-2xl relative overflow-hidden">
          
          <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-rose-500 via-amber-400 to-emerald-500"></div>

          <!-- Form Stage -->
          <div id="quiz-form-stage" class="transition-all duration-500 opacity-100 translate-x-0">
            <div class="flex items-center justify-between mb-6 pb-4 border-b border-slate-800">
              <h3 class="text-lg font-serif font-medium text-white">Audit Diagnostic Parameters</h3>
              <span class="text-[10px] font-mono text-emerald-400 uppercase tracking-widest bg-emerald-500/10 px-2.5 py-1 rounded border border-emerald-500/20">Live Tool</span>
            </div>
            
            <div class="space-y-6">
              <div>
                <label class="block text-[11px] font-mono font-bold uppercase tracking-wider text-slate-400 mb-2">Target University Name</label>
                <input 
                  type="text" 
                  id="univ-name" 
                  placeholder="e.g. Tbilisi State Medical University / Semmelweis University" 
                  class="w-full bg-slate-950 border border-slate-700/80 rounded-xl px-4 py-3.5 text-white text-sm focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-all placeholder:text-slate-600 font-sans" 
                />
              </div>

              <div>
                <label class="block text-[11px] font-mono font-bold uppercase tracking-wider text-slate-400 mb-2">Attached Hospital Bed Capacity (Clinical Volume)</label>
                <div class="grid grid-cols-3 gap-3">
                  <button type="button" class="quiz-btn bg-slate-950 border border-slate-700/80 text-slate-300 text-xs font-semibold py-3 rounded-xl hover:border-slate-500 transition-all cursor-pointer" data-group="beds" data-val="10">Under 500 Beds</button>
                  <button type="button" class="quiz-btn bg-slate-950 border border-slate-700/80 text-slate-300 text-xs font-semibold py-3 rounded-xl hover:border-slate-500 transition-all cursor-pointer" data-group="beds" data-val="20">500 – 800 Beds</button>
                  <button type="button" class="quiz-btn bg-slate-950 border border-slate-700/80 text-slate-300 text-xs font-semibold py-3 rounded-xl hover:border-slate-500 transition-all cursor-pointer" data-group="beds" data-val="35">800+ Beds (High)</button>
                </div>
              </div>

              <div>
                <label class="block text-[11px] font-mono font-bold uppercase tracking-wider text-slate-400 mb-2">Ownership Governance</label>
                <div class="grid grid-cols-2 gap-3">
                  <button type="button" class="quiz-btn bg-slate-950 border border-slate-700/80 text-slate-300 text-xs font-semibold py-3 rounded-xl hover:border-slate-500 transition-all cursor-pointer" data-group="owner" data-val="10">Private / Commercial Society</button>
                  <button type="button" class="quiz-btn bg-slate-950 border border-slate-700/80 text-slate-300 text-xs font-semibold py-3 rounded-xl hover:border-slate-500 transition-all cursor-pointer" data-group="owner" data-val="35">100% Sovereign Government</button>
                </div>
              </div>

              <div>
                <label class="block text-[11px] font-mono font-bold uppercase tracking-wider text-slate-400 mb-2">Medium of Instruction (All 54 Months)</label>
                <div class="grid grid-cols-2 gap-3">
                  <button type="button" class="quiz-btn bg-slate-950 border border-slate-700/80 text-slate-300 text-xs font-semibold py-3 rounded-xl hover:border-slate-500 transition-all cursor-pointer" data-group="lang" data-val="0">Bilingual (English + Local)</button>
                  <button type="button" class="quiz-btn bg-slate-950 border border-slate-700/80 text-slate-300 text-xs font-semibold py-3 rounded-xl hover:border-slate-500 transition-all cursor-pointer" data-group="lang" data-val="30">100% English Mandated</button>
                </div>
              </div>
            </div>

            <div class="mt-8">
              <button 
                id="calculate-btn" 
                class="w-full bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-xs font-bold uppercase tracking-widest py-4 rounded-xl transition-all duration-300 shadow-lg shadow-emerald-500/20 flex items-center justify-center gap-2 group opacity-50 cursor-not-allowed" 
                disabled
              >
                <svg class="w-4 h-4 text-slate-950" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                Calculate Compliance & Safety Score
              </button>
            </div>
          </div>

          <!-- Loading Stage -->
          <div id="quiz-loader-stage" class="hidden flex-col items-center justify-center py-16 text-center transition-all duration-500">
            <div class="relative w-16 h-16 mb-6">
              <div class="absolute inset-0 rounded-full border-2 border-emerald-500/20 border-t-emerald-500 animate-spin"></div>
              <div class="absolute inset-2 rounded-full border-2 border-amber-500/20 border-r-amber-500 animate-spin direction-reverse"></div>
              <div class="absolute inset-0 flex items-center justify-center text-emerald-400">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
              </div>
            </div>
            <h3 class="text-white font-serif text-lg font-medium mb-1">Scanning Statutory Database...</h3>
            <p class="text-slate-400 text-xs font-mono">Cross-referencing NMC Gazette 2021 & European EHEA parameters.</p>
          </div>

          <!-- Result Stage -->
          <div id="quiz-result-stage" class="hidden flex-col items-center text-center transition-all duration-500 py-4">
            <span id="result-badge" class="px-3.5 py-1 rounded-full text-[10px] font-mono font-bold uppercase tracking-widest mb-6 border bg-slate-950 border-slate-700 text-slate-400">Analysis Complete</span>
            
            <div class="relative w-36 h-36 flex items-center justify-center mb-6">
              <svg class="w-full h-full transform -rotate-90" viewBox="0 0 100 100">
                <circle cx="50" cy="50" r="42" fill="none" class="stroke-slate-800" stroke-width="8" />
                <circle id="score-circle" cx="50" cy="50" r="42" fill="none" class="stroke-emerald-500 transition-all duration-1000 ease-out" stroke-width="8" stroke-dasharray="264" stroke-dashoffset="264" />
              </svg>
              <div class="absolute inset-0 flex flex-col items-center justify-center">
                <span id="final-score" class="text-4xl font-black font-serif text-white tracking-tighter">0</span>
                <span class="text-[10px] text-slate-400 font-mono uppercase tracking-widest">/ 100</span>
              </div>
            </div>

            <h3 id="result-title" class="text-2xl font-serif text-white mb-2">Analyzing...</h3>
            <p id="result-desc" class="text-sm text-slate-300 mb-8 max-w-md px-4 leading-relaxed">Processing university data...</p>

            <div class="w-full flex flex-col sm:flex-row gap-3">
              <button id="reset-btn" class="flex-1 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-bold uppercase tracking-wider py-3.5 rounded-xl transition-all cursor-pointer">
                Audit Another University
              </button>
              <a href="/contact" class="flex-[1.5] bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-xs font-bold uppercase tracking-wider py-3.5 rounded-xl transition-all shadow-lg shadow-emerald-500/20 flex items-center justify-center gap-2">
                Request Detailed Audit Dossier
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
              </a>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const btns = document.querySelectorAll('.quiz-btn');
    const calcBtn = document.getElementById('calculate-btn');
    const univInput = document.getElementById('univ-name');
    
    let state = { beds: null, owner: null, lang: null };

    const checkReady = () => {
      if(state.beds !== null && state.owner !== null && state.lang !== null && univInput && univInput.value.trim() !== '') {
        calcBtn.classList.remove('opacity-50', 'cursor-not-allowed');
        calcBtn.removeAttribute('disabled');
      } else if (calcBtn) {
        calcBtn.classList.add('opacity-50', 'cursor-not-allowed');
        calcBtn.setAttribute('disabled', 'true');
      }
    };

    if (univInput) {
      univInput.addEventListener('input', checkReady);
    }

    btns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget;
        const group = target.getAttribute('data-group');
        const val = parseInt(target.getAttribute('data-val') || '0', 10);
        
        document.querySelectorAll(`.quiz-btn[data-group="${group}"]`).forEach(b => {
          b.classList.remove('bg-emerald-500/20', 'border-emerald-500', 'text-emerald-300');
          b.classList.add('bg-slate-950', 'border-slate-700/80', 'text-slate-300');
        });

        target.classList.remove('bg-slate-950', 'border-slate-700/80', 'text-slate-300');
        target.classList.add('bg-emerald-500/20', 'border-emerald-500', 'text-emerald-300');

        state[group] = val;
        checkReady();
      });
    });

    if (calcBtn) {
      calcBtn.addEventListener('click', () => {
        const totalScore = (state.beds || 0) + (state.owner || 0) + (state.lang || 0);
        
        const formStage = document.getElementById('quiz-form-stage');
        const loaderStage = document.getElementById('quiz-loader-stage');
        const resultStage = document.getElementById('quiz-result-stage');
        
        if (formStage) formStage.classList.add('hidden');
        if (loaderStage) {
          loaderStage.classList.remove('hidden');
          loaderStage.classList.add('flex');
        }

        setTimeout(() => {
          if (loaderStage) {
            loaderStage.classList.remove('flex');
            loaderStage.classList.add('hidden');
          }
          if (resultStage) {
            resultStage.classList.remove('hidden');
            resultStage.classList.add('flex');
          }

          const circle = document.getElementById('score-circle');
          const maxOffset = 264;
          const offset = maxOffset - (maxOffset * totalScore) / 100;
          
          setTimeout(() => {
            if (circle) circle.style.strokeDashoffset = offset;
            animateValue("final-score", 0, totalScore, 800);
          }, 50);

          const badge = document.getElementById('result-badge');
          const title = document.getElementById('result-title');
          const desc = document.getElementById('result-desc');
          const univNameVal = univInput ? univInput.value : "Target University";

          if(totalScore >= 85) {
            if (circle) circle.setAttribute('class', 'stroke-emerald-500 transition-all duration-1000 ease-out');
            if (badge) {
              badge.className = "px-3.5 py-1 rounded-full text-[10px] font-mono font-bold uppercase tracking-widest mb-6 border bg-emerald-500/20 border-emerald-500/40 text-emerald-300";
              badge.innerText = "NMC Verified Safe Zone";
            }
            if (title) title.innerHTML = "Highly Recommended & Compliant";
            if (desc) desc.innerHTML = `Based on our statutory matrix, <span class="text-white font-semibold">${univNameVal}</span> satisfies all mandatory clinical and legal NMC regulations.`;
          } else if (totalScore >= 50) {
            if (circle) circle.setAttribute('class', 'stroke-amber-400 transition-all duration-1000 ease-out');
            if (badge) {
              badge.className = "px-3.5 py-1 rounded-full text-[10px] font-mono font-bold uppercase tracking-widest mb-6 border bg-amber-500/20 border-amber-500/40 text-amber-300";
              badge.innerText = "High Risk Parameter Alert";
            }
            if (title) title.innerHTML = "Proceed with Caution";
            if (desc) desc.innerHTML = `Commercial agents actively sell <span class="text-white font-semibold">${univNameVal}</span>, but it carries clinical volume or medium-of-instruction risks. Verify accreditation.`;
          } else {
            if (circle) circle.setAttribute('class', 'stroke-rose-500 transition-all duration-1000 ease-out');
            if (badge) {
              badge.className = "px-3.5 py-1 rounded-full text-[10px] font-mono font-bold uppercase tracking-widest mb-6 border bg-rose-500/20 border-rose-500/40 text-rose-300";
              badge.innerText = "Non-Compliant / Blacklisted";
            }
            if (title) title.innerHTML = "Severe Disqualification Risk";
            if (desc) desc.innerHTML = `Critical alert! <span class="text-white font-semibold">${univNameVal}</span> fails key clauses of the NMC 2021 Gazette. Your degree may not be recognized for practice in India.`;
          }
        }, 1200);
      });
    }

    const resetBtn = document.getElementById('reset-btn');
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        const resultStage = document.getElementById('quiz-result-stage');
        const formStage = document.getElementById('quiz-form-stage');
        const scoreCircle = document.getElementById('score-circle');
        const finalScore = document.getElementById('final-score');

        if (resultStage) {
          resultStage.classList.add('hidden');
          resultStage.classList.remove('flex');
        }
        if (formStage) formStage.classList.remove('hidden');
        
        if (scoreCircle) scoreCircle.style.strokeDashoffset = '264';
        if (finalScore) finalScore.innerText = '0';
        
        if (univInput) univInput.value = '';
        state = { beds: null, owner: null, lang: null };
        btns.forEach(b => {
          b.classList.remove('bg-emerald-500/20', 'border-emerald-500', 'text-emerald-300');
          b.classList.add('bg-slate-950', 'border-slate-700/80', 'text-slate-300');
        });
        checkReady();
      });
    }

    function animateValue(id, start, end, duration) {
      if (start === end) return;
      const obj = document.getElementById(id);
      if (!obj) return;
      const range = end - start;
      let current = start;
      const increment = end > start ? 1 : -1;
      const stepTime = Math.abs(Math.floor(duration / (range || 1)));
      const timer = setInterval(() => {
        current += increment;
        obj.innerHTML = String(current);
        if (current === end) { clearInterval(timer); }
      }, Math.max(stepTime, 10));
    }
  });
</script>