---
// src/pages/index.astro
// 👑 AUGUST-2026 UNIFIED KNOWLEDGE GRAPH & CITATION ENGINE
// Multi-Entity Graph (WebSite + EducationalOrg + LocalBusiness + Services + Founder + FAQ)

import Layout from '../layouts/Layout.astro';
import ROICalculator from '../components/ROICalculator.astro';
import Destinations from '../components/Destinations.astro';
import Services from '../components/Services.astro';
import Visionaries from '../components/Visionaries.astro';
import SuccessStories from '../components/SuccessStories.astro';
import Footer from '../components/Footer.astro';
import WhatsAppWidget from '../components/WhatsAppWidget.astro';
import FAQ, { faqs } from '../components/FAQ.astro';
import UniversitiesMarquee from '../components/UniversitiesMarquee.astro';
import HeroLeadModal from '../components/HeroLeadModal.tsx';
import { getCollection } from 'astro:content';

import { Picture } from 'astro:assets';
import heroImage from '../assets/home-hero.avif';

const seoTitle = "Study Abroad & Overseas Education Consultants in Kolhapur | Finesse";
const seoDescription = "Kolhapur's premier overseas education consultants. Specializing in zero tuition fee public universities in Germany, 100% scholarships in Italy, and NMC-compliant MBBS.";

// 🚀 Fetch Latest 3 Intelligence Audits for Topical Authority Integration
const allAudits = await getCollection('intelligence');
const featuredAudits = allAudits
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

// 🛡️ 2026 UNIFIED KNOWLEDGE GRAPH SCHEMA: Deeply interconnected entity graph
const siteSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${Astro.site}#website`,
      "name": "Finesse Overseas Education",
      "url": String(Astro.site),
      "publisher": { "@id": `${Astro.site}#organization` },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": `${Astro.site}search?q={search_term_string}`
        },
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": ["EducationalOrganization", "LocalBusiness"],
      "@id": `${Astro.site}#organization`,
      "name": "Finesse Overseas Education",
      "alternateName": ["Finesse Study Abroad Kolhapur", "Finesse Overseas"],
      "description": seoDescription,
      "url": String(Astro.site),
      "logo": {
        "@type": "ImageObject",
        "url": "https://finesseoverseas.com/logo.png",
        "width": 200,
        "height": 60
      },
      "telephone": "+919850069600",
      "email": "info@finesseoverseas.in",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Samarth Sakshi Plaza, First Floor, Above Sohala Showroom, Beside Lenskart, 4th Lane, Rajarampuri",
        "addressLocality": "Kolhapur",
        "postalCode": "416008",
        "addressRegion": "Maharashtra",
        "addressCountry": "IN"
      },
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"],
        "opens": "10:30",
        "closes": "18:30"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.7",
        "reviewCount": "61",
        "bestRating": "5",
        "worstRating": "1"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 16.698246,
        "longitude": 74.241517
      },
      "sameAs": [
        "https://www.facebook.com/FinesseOverseasEducation",
        "https://www.instagram.com/finesseoverseaseducation/",
        "https://youtube.com/@finesseoverseaseducation1272?si=BCKfbpbBlf8PM86L",
        "https://maps.google.com/?cid=11646274483750008573"
      ],
      "priceRange": "$$",
      "areaServed": [
        { "@type": "City", "name": "Kolhapur" },
        { "@type": "City", "name": "Pune" },
        { "@type": "City", "name": "Sangli" },
        { "@type": "City", "name": "Satara" },
        { "@type": "City", "name": "Belgaum" },
        { "@type": "State", "name": "Maharashtra" },
        { "@type": "Country", "name": "India" }
      ],
      "founder": {
        "@type": "Person",
        "name": "Jayant Patil",
        "jobTitle": "Founder & Strategic Director",
        "alumniOf": "Veermata Jijabai Technological Institute (VJTI) & Jamnalal Bajaj Institute of Management Studies (JBIMS)",
        "knowsAbout": ["European Education Architecture", "German Public University Admissions", "Career Strategy"]
      },
      "employee": [
        {
          "@type": "Person",
          "name": "Sneha Pai",
          "jobTitle": "Director & Lead Mentor",
          "hasCredential": "Cambridge Certified Master Mentor"
        },
        {
          "@type": "Person",
          "name": "Rohit Kasture",
          "jobTitle": "Senior Placement Strategist",
          "knowsAbout": ["NMC FMGL 2021 Regulations", "APS Verification Protocols"]
        }
      ],
      "knowsAbout": [
        "Tuition-Free Higher Education in Germany",
        "Akademische Prüfstelle (APS Certificate) Verification",
        "Italy ISEE Parificato and DSU Regional Scholarships",
        "National Medical Commission (NMC) FMGL Regulations 2021",
        "Austrian Public Higher Education Admissions",
        "Schengen Student Visa Processing",
        "European Credit Transfer and Accumulation System (ECTS)"
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "European Higher Education & Medical Admissions Services",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Germany Public University Admission & APS Processing",
              "description": "Comprehensive profile evaluation, public university application, and APS New Delhi document notarization for zero tuition fee studies in Germany."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Italy 100% Scholarship & ISEE Parificato Strategy",
              "description": "Assistance with Italian DSU regional need-based scholarships offering 100% tuition waivers and annual stipends up to €7,400."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "NMC FMGL 2021-Compliant European MBBS Counseling",
              "description": "Legally verified 54+12 month single-institution English-taught medical admissions in compliant European government universities."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Austria Public Higher Education Admissions",
              "description": "Zero blocked account European higher education pathway in Austria with affordable semester contributions."
            }
          }
        ]
      }
    },
    {
      "@type": "WebPage",
      "@id": `${Astro.site}#webpage`,
      "url": String(Astro.site),
      "name": seoTitle,
      "description": seoDescription,
      "isPartOf": { "@id": `${Astro.site}#website` },
      "about": [
        { "@type": "Thing", "name": "Higher Education in Germany", "sameAs": "https://en.wikipedia.org/wiki/Education_in_Germany" },
        { "@type": "Thing", "name": "National Medical Commission", "sameAs": "https://en.wikipedia.org/wiki/National_Medical_Commission" },
        { "@type": "Thing", "name": "German Academic Exchange Service", "sameAs": "https://en.wikipedia.org/wiki/German_Academic_Exchange_Service" }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": `${Astro.site}#faq`,
      "mainEntity": faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
});
---

<Layout title={seoTitle} description={seoDescription} schema={siteSchema}>
  
<section class="relative flex flex-col items-center justify-center text-center px-4 overflow-hidden bg-[#0A0F1C] pt-28 pb-32 lg:pt-36 lg:pb-36">
  
  <div class="absolute inset-0 z-0 bg-[#0A0F1C]">
    <Picture 
      src={heroImage} 
      alt="Finesse Overseas Education Hero Background"
      widths={[400, 800, 1200, 1920]} 
      sizes="(max-width: 400px) 400px, (max-width: 800px) 800px, (max-width: 1200px) 1200px, 1920px"
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      quality={40}
      fetchpriority="high"
      loading="eager"
      decoding="async"
      class="absolute inset-0 w-full h-full object-cover object-center opacity-[0.08] grayscale mix-blend-luminosity"
    />
    
    <div class="absolute top-0 left-0 w-full h-full bg-gradient-to-b from-[#0A0F1C]/90 via-[#0A0F1C]/40 to-[#0A0F1C]"></div>
    <div class="absolute top-1/4 left-1/4 w-[500px] h-[500px] bg-teal-600/15 rounded-full blur-[120px] pointer-events-none hidden md:block"></div>
    <div class="absolute bottom-1/4 right-1/4 w-[500px] h-[500px] bg-blue-600/10 rounded-full blur-[120px] pointer-events-none hidden md:block"></div>

    <!-- 🌐 OPTION 2: SUBTLE AMBIENT GLOBAL ARCS (LEFT & RIGHT - REVERSIBLE) -->
    <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden hidden lg:block" aria-hidden="true">
      <!-- Left Global Orbit / Flight Trajectory Arc -->
      <svg class="absolute -left-12 top-1/2 -translate-y-1/2 w-[380px] h-[460px] opacity-20 text-teal-400" viewBox="0 0 400 500" fill="none">
        <circle cx="20" cy="250" r="160" stroke="currentColor" stroke-width="1" stroke-dasharray="4 6" opacity="0.4" />
        <circle cx="20" cy="250" r="240" stroke="currentColor" stroke-width="1.2" stroke-dasharray="8 8" opacity="0.3" />
        <circle cx="20" cy="250" r="320" stroke="currentColor" stroke-width="1" stroke-opacity="0.15" />
        <path d="M 30 380 Q 160 250, 300 170 T 380 110" stroke="url(#arc-grad-left)" stroke-width="1.5" stroke-dasharray="5 5" />
        <circle cx="300" cy="170" r="3.5" fill="#2dd4bf" opacity="0.8" />
        <circle cx="300" cy="170" r="8" stroke="#2dd4bf" stroke-width="1" opacity="0.35" class="animate-ping" />
        <circle cx="160" cy="250" r="2.5" fill="#2dd4bf" opacity="0.5" />
        <defs>
          <linearGradient id="arc-grad-left" x1="0%" y1="100%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#0d9488" stop-opacity="0.1" />
            <stop offset="60%" stop-color="#2dd4bf" stop-opacity="0.7" />
            <stop offset="100%" stop-color="#60a5fa" stop-opacity="0.8" />
          </linearGradient>
        </defs>
      </svg>

      <!-- Right Global Orbit / Flight Trajectory Arc -->
      <svg class="absolute -right-12 top-1/2 -translate-y-1/2 w-[380px] h-[460px] opacity-20 text-cyan-400" viewBox="0 0 400 500" fill="none">
        <circle cx="380" cy="250" r="160" stroke="currentColor" stroke-width="1" stroke-dasharray="4 6" opacity="0.4" />
        <circle cx="380" cy="250" r="240" stroke="currentColor" stroke-width="1.2" stroke-dasharray="8 8" opacity="0.3" />
        <circle cx="380" cy="250" r="320" stroke="currentColor" stroke-width="1" stroke-opacity="0.15" />
        <path d="M 370 380 Q 240 250, 100 170 T 20 110" stroke="url(#arc-grad-right)" stroke-width="1.5" stroke-dasharray="5 5" />
        <circle cx="100" cy="170" r="3.5" fill="#38bdf8" opacity="0.8" />
        <circle cx="100" cy="170" r="8" stroke="#38bdf8" stroke-width="1" opacity="0.35" class="animate-ping" />
        <circle cx="240" cy="250" r="2.5" fill="#38bdf8" opacity="0.5" />
        <defs>
          <linearGradient id="arc-grad-right" x1="100%" y1="100%" x2="0%" y2="0%">
            <stop offset="0%" stop-color="#0284c7" stop-opacity="0.1" />
            <stop offset="60%" stop-color="#38bdf8" stop-opacity="0.7" />
            <stop offset="100%" stop-color="#2dd4bf" stop-opacity="0.8" />
          </linearGradient>
        </defs>
      </svg>
    </div>
  </div>
  
  <div class="relative z-10 max-w-5xl mx-auto flex flex-col items-center">
    
    <!-- 🌟 TRUST PROOF BADGE -->
    <div class="mb-7 inline-flex items-center gap-2.5 px-4.5 py-1.5 rounded-full bg-slate-900/90 border border-slate-800 shadow-lg backdrop-blur-md">
      <div class="flex items-center gap-1 text-amber-400">
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
      </div>
      <span class="text-xs sm:text-sm font-medium text-slate-200">
        <strong class="text-white font-semibold">🏆 Kolhapur's #1 Most Trusted Overseas Education Consultancy · Est. 2004</strong>
      </span>
    </div>

    <!-- 🎓 BALANCED 2-LINE HEADLINE (Exact Keyword Targeting for Kolhapur #1 Ranking) -->
    <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-[48px] font-extrabold tracking-tight mb-6 text-white leading-[1.18] max-w-5xl mx-auto">
      <span class="block text-slate-100">Study Abroad & Overseas Education</span>
      <span class="block text-transparent bg-clip-text bg-gradient-to-r from-teal-300 via-emerald-300 to-cyan-300">
        Consultants in Kolhapur
      </span>
    </h1>
    
    <!-- 🤝 HUMAN, WARM, LOCAL SUBTITLE -->
    <p class="text-base sm:text-lg text-slate-300 mb-10 max-w-2xl mx-auto leading-relaxed font-normal">
      Specializing in zero-tuition public universities in Germany, 100% scholarships in Italy & NMC-compliant European MBBS. Mentored personally at our <a href="/study-abroad-consultants-in-kolhapur" class="text-white font-medium underline underline-offset-4 decoration-teal-400 hover:text-teal-300 transition-colors">Rajarampuri, Kolhapur counseling headquarters</a>.
    </p>
    
    <!-- 🎯 DUAL CTA (Balanced, Pixel-Perfect) -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center w-full sm:w-auto relative z-20">
      <HeroLeadModal client:load />

      <a 
        href="https://wa.me/919850069600?text=Hello%20Finesse%20Team!%20%F0%9F%91%8B%20I%20would%20like%20to%20speak%20with%20a%20senior%20mentor%20about%20studying%20in%20Europe."
        target="_blank"
        rel="noopener noreferrer"
        data-track="hero-whatsapp-hotline"
        class="group relative z-20 py-3.5 px-7 bg-slate-900/90 hover:bg-slate-800 text-white font-semibold rounded-xl border border-slate-700 hover:border-emerald-400/50 transition-all duration-200 w-full sm:w-auto inline-flex items-center justify-center gap-2.5 shadow-lg hover:shadow-[0_0_20px_rgba(37,211,102,0.2)] hover:-translate-y-0.5 cursor-pointer text-sm sm:text-base font-sans whitespace-nowrap"
      >
        <svg class="w-5 h-5 text-[#25D366] fill-current shrink-0" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
        </svg>
        <span>Speak with a Senior Mentor</span>
      </a>
    </div>

  </div>
</section>

  <section class="py-9 bg-slate-900 text-white relative z-20 -mt-14 mx-4 md:mx-auto max-w-7xl rounded-2xl shadow-2xl">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 px-6 md:px-12 text-center md:divide-x divide-slate-700/50">
      <div class="px-4">
        <div class="text-3xl font-black text-teal-400 mb-1">22+</div>
        <div class="text-sm text-slate-300 font-medium">Years Experience</div>
      </div>
      <div class="px-4">
        <div class="text-3xl font-black text-teal-400 mb-1">1000+</div>
        <div class="text-sm text-slate-300 font-medium">Students Placed</div>
      </div>
      <div class="px-4">
        <div class="text-3xl font-black text-teal-400 mb-1">99%</div>
        <div class="text-sm text-slate-300 font-medium">Visa Success Rate</div>
      </div>
      <div class="px-4">
        <div class="text-xl font-bold text-teal-400 mb-1 mt-1">Public Uni.</div>
        <div class="text-sm text-slate-300 font-medium">Admission Experts</div>
      </div>
    </div>
  </section>

  <UniversitiesMarquee />
  <Destinations />
  <ROICalculator />
  <Services />
  <Visionaries />
  <SuccessStories />

  <!-- 👑 SOVEREIGN CREDENTIALS & COMPLIANCE MATRIX (GEO / E-E-A-T Engine) -->
  <section class="py-24 bg-[#050814] relative overflow-hidden" id="sovereign-credentials">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_bottom,_var(--tw-gradient-stops))] from-teal-900/10 via-transparent to-transparent opacity-50"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <div class="text-center mb-16">
        <span class="text-teal-400 font-bold tracking-widest uppercase mb-3 block text-xs font-sans">Sovereign Compliance & Authority</span>
        <h2 class="text-3xl md:text-5xl font-serif text-white font-medium mb-4 tracking-tight">The Finesse Security Blueprint</h2>
        <p class="text-slate-400 max-w-2xl mx-auto text-base font-light leading-relaxed">We operate on absolute transparency. Every student placement is audited against strict sovereign and national regulations.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 font-sans">
        
        <!-- Compliance Node 1: Germany APS & DOV -->
        <div class="p-8 bg-[#0a0f1c]/50 border border-slate-800/80 rounded-3xl backdrop-blur-md hover:border-teal-500/30 transition-all duration-500 group relative">
          <div class="absolute top-8 right-8 w-2 h-2 rounded-full bg-emerald-500 animate-ping"></div>
          <div class="flex items-center gap-3 mb-6">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
            <h3 class="text-xl font-serif text-white font-medium">Germany Public Admissions Matrix</h3>
          </div>
          <p class="text-slate-400 text-sm leading-relaxed mb-6 font-light">
            Authorized placement matrix for European public institutions. We facilitate direct verification pipelines for the **Akademische Prüfstelle (APS Certificate)** and the **Declaration of Value (DOV)** protocols. Every application is vetted directly through sovereign state portals to ensure 100% tuition-free eligibility.
          </p>
          <div class="flex items-center gap-2 text-[10px] text-teal-400 font-black tracking-widest uppercase font-mono">
            Verification: ACTIVE STATUS [🟢]
          </div>
        </div>

        <!-- Compliance Node 2: NMC FMGL 2021 -->
