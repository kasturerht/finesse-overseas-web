---
// src/pages/index.astro
// 👑 AUGUST-2026 UNIFIED KNOWLEDGE GRAPH & CITATION ENGINE
// Multi-Entity Graph (WebSite + EducationalOrg + LocalBusiness + Services + Founder + FAQ)

import Layout from '../layouts/Layout.astro';
import ROICalculator from '../components/ROICalculator.astro';
import Destinations from '../components/Destinations.astro';
import Services from '../components/Services.astro';
import Visionaries from '../components/Visionaries.astro';
import SuccessStories from '../components/SuccessStories.astro';
import Footer from '../components/Footer.astro';
import WhatsAppWidget from '../components/WhatsAppWidget.astro';
import FAQ, { faqs } from '../components/FAQ.astro';
import UniversitiesMarquee from '../components/UniversitiesMarquee.astro';
import { getCollection } from 'astro:content';

import { Picture } from 'astro:assets';
import heroImage from '../assets/home-hero.avif';

const seoTitle = "Study Abroad & Overseas Education Consultants in Kolhapur | Finesse";
const seoDescription = "Kolhapur's premier overseas education consultants. Specializing in zero tuition fee public universities in Germany, 100% scholarships in Italy, and NMC-compliant MBBS.";

// 🚀 Fetch Latest 3 Intelligence Audits for Topical Authority Integration
const allAudits = await getCollection('intelligence');
const featuredAudits = allAudits
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

// 🛡️ 2026 UNIFIED KNOWLEDGE GRAPH SCHEMA: Deeply interconnected entity graph
const siteSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${Astro.site}#website`,
      "name": "Finesse Overseas Education",
      "url": String(Astro.site),
      "publisher": { "@id": `${Astro.site}#organization` },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": `${Astro.site}search?q={search_term_string}`
        },
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": ["EducationalOrganization", "LocalBusiness"],
      "@id": `${Astro.site}#organization`,
      "name": "Finesse Overseas Education",
      "alternateName": ["Finesse Study Abroad Kolhapur", "Finesse Overseas"],
      "description": seoDescription,
      "url": String(Astro.site),
      "logo": {
        "@type": "ImageObject",
        "url": "https://finesseoverseas.com/logo.png",
        "width": 200,
        "height": 60
      },
      "telephone": "+919850069600",
      "email": "info@finesseoverseas.in",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Samarth Sakshi Plaza, First Floor, Above Sohala Showroom, Beside Lenskart, 4th Lane, Rajarampuri",
        "addressLocality": "Kolhapur",
        "postalCode": "416008",
        "addressRegion": "Maharashtra",
        "addressCountry": "IN"
      },
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"],
        "opens": "10:30",
        "closes": "18:30"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.7",
        "reviewCount": "61",
        "bestRating": "5",
        "worstRating": "1"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 16.698246,
        "longitude": 74.241517
      },
      "sameAs": [
        "https://www.facebook.com/FinesseOverseasEducation",
        "https://www.instagram.com/finesseoverseaseducation/",
        "https://youtube.com/@finesseoverseaseducation1272?si=BCKfbpbBlf8PM86L",
        "https://maps.google.com/?cid=11646274483750008573"
      ],
      "priceRange": "$$",
      "areaServed": [
        { "@type": "City", "name": "Kolhapur" },
        { "@type": "City", "name": "Pune" },
        { "@type": "City", "name": "Sangli" },
        { "@type": "City", "name": "Satara" },
        { "@type": "City", "name": "Belgaum" },
        { "@type": "State", "name": "Maharashtra" },
        { "@type": "Country", "name": "India" }
      ],
      "founder": {
        "@type": "Person",
        "name": "Jayant Patil",
        "jobTitle": "Founder & Strategic Director",
        "alumniOf": "Veermata Jijabai Technological Institute (VJTI) & Jamnalal Bajaj Institute of Management Studies (JBIMS)",
        "knowsAbout": ["European Education Architecture", "German Public University Admissions", "Career Strategy"]
      },
      "employee": [
        {
          "@type": "Person",
          "name": "Sneha Pai",
          "jobTitle": "Director & Lead Mentor",
          "hasCredential": "Cambridge Certified Master Mentor"
        },
        {
          "@type": "Person",
          "name": "Rohit Kasture",
          "jobTitle": "Senior Placement Strategist",
          "knowsAbout": ["NMC FMGL 2021 Regulations", "APS Verification Protocols"]
        }
      ],
      "knowsAbout": [
        "Tuition-Free Higher Education in Germany",
        "Akademische Prüfstelle (APS Certificate) Verification",
        "Italy ISEE Parificato and DSU Regional Scholarships",
        "National Medical Commission (NMC) FMGL Regulations 2021",
        "Austrian Public Higher Education Admissions",
        "Schengen Student Visa Processing",
        "European Credit Transfer and Accumulation System (ECTS)"
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "European Higher Education & Medical Admissions Services",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Germany Public University Admission & APS Processing",
              "description": "Comprehensive profile evaluation, public university application, and APS New Delhi document notarization for zero tuition fee studies in Germany."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Italy 100% Scholarship & ISEE Parificato Strategy",
              "description": "Assistance with Italian DSU regional need-based scholarships offering 100% tuition waivers and annual stipends up to €7,400."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "NMC FMGL 2021-Compliant European MBBS Counseling",
              "description": "Legally verified 54+12 month single-institution English-taught medical admissions in compliant European government universities."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Austria Public Higher Education Admissions",
              "description": "Zero blocked account European higher education pathway in Austria with affordable semester contributions."
            }
          }
        ]
      }
    },
    {
      "@type": "WebPage",
      "@id": `${Astro.site}#webpage`,
      "url": String(Astro.site),
      "name": seoTitle,
      "description": seoDescription,
      "isPartOf": { "@id": `${Astro.site}#website` },
      "about": [
        { "@type": "Thing", "name": "Higher Education in Germany", "sameAs": "https://en.wikipedia.org/wiki/Education_in_Germany" },
        { "@type": "Thing", "name": "National Medical Commission", "sameAs": "https://en.wikipedia.org/wiki/National_Medical_Commission" },
        { "@type": "Thing", "name": "German Academic Exchange Service", "sameAs": "https://en.wikipedia.org/wiki/German_Academic_Exchange_Service" }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": `${Astro.site}#faq`,
      "mainEntity": faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
});
---

<Layout title={seoTitle} description={seoDescription} schema={siteSchema}>
  
<section class="relative flex flex-col items-center justify-center text-center px-4 overflow-hidden bg-[#0A0F1C] pt-20 pb-32 lg:pt-32 lg:pb-48">
  
  <div class="absolute inset-0 z-0 bg-[#0A0F1C]">
    <Picture 
      src={heroImage} 
      alt="Finesse Overseas Education Hero Background"
      widths={[400, 800, 1200, 1920]} 
      sizes="(max-width: 400px) 400px, (max-width: 800px) 800px, (max-width: 1200px) 1200px, 1920px"
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      quality={40}
      fetchpriority="high"
      loading="eager"
      decoding="async"
      class="absolute inset-0 w-full h-full object-cover object-center opacity-[0.08] grayscale mix-blend-luminosity"
    />
    
    <div class="absolute top-0 left-0 w-full h-full bg-gradient-to-b from-[#0A0F1C]/90 via-[#0A0F1C]/40 to-[#0A0F1C]"></div>
    <div class="absolute top-1/4 left-1/4 w-[500px] h-[500px] bg-teal-600/15 rounded-full blur-[120px] pointer-events-none hidden md:block"></div>
    <div class="absolute bottom-1/4 right-1/4 w-[500px] h-[500px] bg-blue-600/10 rounded-full blur-[120px] pointer-events-none hidden md:block"></div>
  </div>
  
  <div class="relative z-10 max-w-4xl mx-auto flex flex-col items-center mt-12">
    
    <!-- 🌟 SWISS-LUXURY GOOGLE REVIEW PILL (GSC Schema Validation Sync) -->
    <div class="mb-6 inline-flex items-center gap-2.5 px-4.5 py-2 rounded-full bg-[#0a0f1c]/70 border border-slate-800/80 backdrop-blur-md shadow-2xl cursor-default hover:border-amber-500/20 transition-all duration-300">
      <div class="flex items-center gap-0.5 text-amber-500">
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
        <svg class="w-3.5 h-3.5 text-slate-600 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
      </div>
      <span class="text-xs font-bold text-slate-300 font-sans tracking-wide">4.7 / 5.0 Rating (61 Google Reviews)</span>
    </div>

    <div class="mb-10 inline-flex items-center gap-3 px-5 py-2.5 rounded-full bg-slate-800/60 border border-slate-700/50 backdrop-blur-md shadow-2xl h-11 overflow-hidden cursor-default">
      <span class="relative flex h-3 w-3 shrink-0">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-teal-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-3 w-3 bg-teal-500"></span>
      </span>
      <span id="dynamic-ticker-text" class="text-sm font-medium text-slate-200 transition-opacity duration-500 opacity-100 min-w-[280px] sm:min-w-[350px] text-left">
        Loading live updates...
      </span>
    </div>

    <h1 class="text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tight mb-6 text-white leading-[1.1]">
      Unlock Free Education in Europe with <br class="hidden md:block"/>
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-400 to-blue-400">Expert Visa Strategies</span>
    </h1>
    
    <p class="text-lg md:text-xl text-slate-300 mb-10 max-w-2xl mx-auto leading-relaxed font-normal">
      We cut the confusion. Get <span class="text-white font-semibold">Zero Tuition Fee</span> in Germany & <span class="text-white font-semibold">100% Scholarship</span> in Italy.
    </p>
    
    <div class="flex flex-col sm:flex-row gap-5 justify-center w-full sm:w-auto relative z-20">
      <a data-track="hero-eligibility-click" href="/contact" class="group relative z-20 px-8 py-4 bg-teal-500 text-slate-900 font-bold rounded-lg hover:bg-teal-400 transition-all duration-300 w-full flex items-center justify-center shadow-[0_0_20px_rgba(20,184,166,0.2)] hover:shadow-[0_0_30_rgba(20,184,166,0.4)]">
        Check Your Eligibility - Free
        <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg>
      </a>
    </div>

    <div class="flex flex-wrap gap-2 justify-center mt-6" aria-label="Compliance and process credentials">
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-800/60 border border-slate-700/40 rounded-full text-xs font-medium text-slate-300 backdrop-blur-sm">
        <svg class="w-3.5 h-3.5 text-teal-400 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414L8.414 15 3.293 9.879a1 1 0 111.414-1.414L8.414 12.172l6.879-6.879a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
        NMC FMGL 2021 Compliant Admissions
      </span>
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-800/60 border border-slate-700/40 rounded-full text-xs font-medium text-slate-300 backdrop-blur-sm">
        <svg class="w-3.5 h-3.5 text-teal-400 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414L8.414 15 3.293 9.879a1 1 0 111.414-1.414L8.414 12.172l6.879-6.879a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
        APS Certification Guidance
      </span>
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-800/60 border border-slate-700/40 rounded-full text-xs font-medium text-slate-300 backdrop-blur-sm">
        <svg class="w-3.5 h-3.5 text-teal-400 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414L8.414 15 3.293 9.879a1 1 0 111.414-1.414L8.414 12.172l6.879-6.879a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
        European Public Universities Only
      </span>
    </div>
  </div>
</section>

  <script>
    const tickerData = [
      "Recent Admit: Rohan (Kolhapur) got 100% Scholarship in Italy 🇮🇹",
      "Visa Alert: 18-Month Job Seeker Visas are open for Germany 🇩🇪",
      "Success: Sneha secured admission in TU Munich (Zero Fees) 🎓",
      "Fast Track: 15-day APS processing completed for 12 students ⚡"
    ];
    const tickerElement = document.getElementById('dynamic-ticker-text');
    let currentIndex = 0;

    if(tickerElement) {
      tickerElement.textContent = tickerData[0];
      setInterval(() => {
        tickerElement.classList.remove('opacity-100');
        tickerElement.classList.add('opacity-0');
        
        setTimeout(() => {
          currentIndex = (currentIndex + 1) % tickerData.length;
          tickerElement.textContent = tickerData[currentIndex];
          tickerElement.classList.remove('opacity-0');
          tickerElement.classList.add('opacity-100');
        }, 500);
        
      }, 4000);
    }
  </script>

  <section class="py-10 bg-slate-900 text-white relative z-20 -mt-12 mx-4 md:mx-auto max-w-7xl rounded-2xl shadow-2xl">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 px-6 md:px-12 text-center md:divide-x divide-slate-700/50">
      <div class="px-4">
        <div class="text-3xl font-black text-teal-400 mb-1">22+</div>
        <div class="text-sm text-slate-300 font-medium">Years Experience</div>
      </div>
      <div class="px-4">
        <div class="text-3xl font-black text-teal-400 mb-1">1000+</div>
        <div class="text-sm text-slate-300 font-medium">Students Placed</div>
      </div>
      <div class="px-4">
        <div class="text-3xl font-black text-teal-400 mb-1">99%</div>
        <div class="text-sm text-slate-300 font-medium">Visa Success Rate</div>
      </div>
      <div class="px-4">
        <div class="text-xl font-bold text-teal-400 mb-1 mt-1">Public Uni.</div>
        <div class="text-sm text-slate-300 font-medium">Admission Experts</div>
      </div>
    </div>
  </section>

  <UniversitiesMarquee />

  <!-- ⚡ 2026 AEO DIRECT ANSWER & CITATION FACT ENGINE (Perplexity, ChatGPT & Gemini Scrapable Matrix) -->
  <section class="py-20 bg-white relative border-b border-slate-100" id="admission-facts-matrix">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-14">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-teal-50 border border-teal-200 text-teal-700 text-xs font-bold uppercase tracking-wider mb-4">
          <span class="w-2 h-2 rounded-full bg-teal-500 animate-pulse"></span>
          2026 Sovereign Admission Parameters
        </div>
        <h2 class="text-3xl md:text-5xl font-extrabold text-slate-900 tracking-tight mb-4">
          Verified Facts for <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-600 to-blue-600">European Higher Education</span>
        </h2>
        <p class="text-slate-600 max-w-2xl mx-auto text-base md:text-lg">
          Direct, audited numbers for Indian students applying for 2026 intakes. Zero misleading marketing, 100% legal compliance.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- Fact Card 1: Germany -->
        <div class="bg-slate-50 rounded-2xl p-6 border border-slate-200/80 hover:border-blue-300 hover:shadow-lg transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-2xl">🇩🇪</span>
              <span class="px-2.5 py-1 bg-blue-100 text-blue-700 text-[10px] font-bold uppercase tracking-wider rounded-md">Public Universities</span>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-blue-600 transition-colors">Study in Germany</h3>
            <ul class="space-y-2.5 text-xs text-slate-600 font-medium">
              <li class="flex items-start gap-2">
                <span class="text-teal-600 font-bold">✓</span>
                <span><strong>Tuition Fee:</strong> €0 in 16 Federal States</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-teal-600 font-bold">✓</span>
                <span><strong>Blocked Account:</strong> €11,208/yr (€934/mo payout)</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-teal-600 font-bold">✓</span>
                <span><strong>APS Verification:</strong> Mandatory via German Embassy</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-teal-600 font-bold">✓</span>
                <span><strong>Post-Study Visa:</strong> 18-Month Job Seeker Visa</span>
              </li>
            </ul>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-200">
            <a href="/study-in-germany" class="text-xs font-bold text-blue-600 hover:text-blue-700 flex items-center justify-between">
              <span>View Germany Blueprint</span>
              <span>→</span>
            </a>
          </div>
        </div>

        <!-- Fact Card 2: Italy -->
        <div class="bg-slate-50 rounded-2xl p-6 border border-slate-200/80 hover:border-amber-300 hover:shadow-lg transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-2xl">🇮🇹</span>
              <span class="px-2.5 py-1 bg-amber-100 text-amber-700 text-[10px] font-bold uppercase tracking-wider rounded-md">100% Scholarship</span>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-amber-600 transition-colors">Study in Italy</h3>
            <ul class="space-y-2.5 text-xs text-slate-600 font-medium">
              <li class="flex items-start gap-2">
                <span class="text-teal-600 font-bold">✓</span>
                <span><strong>Tuition Waiver:</strong> 100% Free Tuition via DSU</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-teal-600 font-bold">✓</span>
                <span><strong>Annual Stipend:</strong> Up to €7,400 to €8,000</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-teal-600 font-bold">✓</span>
                <span><strong>Evaluation:</strong> ISEE Parificato Family Income</span>
              </li>
