              "Saved us from agent traps and guided us to a genuine medical university.",
              "Strongly recommend Finesse Overseas Rajarampuri to all NEET students!"
            ]
          },
          general: {
            openings: [
              "Undoubtedly the best study abroad & overseas education consultants in Kolhapur.",
              "Finesse Overseas Education is the most trusted consultancy in Western Maharashtra.",
              "Had a wonderful consultation session at Finesse Rajarampuri office.",
              "Kolhapur's premier overseas education consultancy with 22+ years of on-ground expertise.",
              "Truly exceptional guidance for higher education abroad at Finesse.",
              "Very positive and professional experience with Finesse Overseas Kolhapur."
            ],
            mentors: [
              "Jayant Patil sir and the team provided world-class profile evaluation.",
              "The counseling team evaluated my career aspirations and academic profile thoroughly.",
              "The mentors are highly experienced, patient, and completely transparent.",
              "Jayant sir's alumni background from VJTI & JBIMS reflects in their strategic approach.",
              "The staff at Rajarampuri 4th Lane office are extremely courteous and knowledgeable.",
              "They treat your education like a serious career decision, not a sales business."
            ],
            specifics: [
              "Their deep knowledge of European higher education and visa protocols is unmatched.",
              "They operate with complete transparency, charging fair fees with zero hidden kickbacks.",
              "From profile evaluation, university shortlisting to visa filing, everything was smooth.",
              "They helped me choose the right country and university tailored to my budget.",
              "Clear, honest guidance on post-study work visas and permanent residency pathways.",
              "Their 99% visa success rate over 22 years is well-deserved and evident in their work.",
              "A breath of fresh air compared to traditional commission-driven study abroad agencies.",
              "They provide continuous support until the student safely lands at the university."
            ],
            closings: [
              "5/5 stars! Highly recommended to every student and parent in Kolhapur and Sangli.",
              "Best consultancy in Kolhapur for genuine overseas education guidance.",
              "Very grateful to the entire team at Rajarampuri. Best decision I made!",
              "Transparent, professional, and reliable throughout. Highly recommended!",
              "Thank you Finesse team for guiding my career on the right global path.",
              "10/10 recommendation for authentic study abroad counseling."
            ]
          }
        };

        function pickRandom(arr) {
          return arr[Math.floor(Math.random() * arr.length)];
        }

        function generateUniqueReview(topic) {
          const pool = sentencePools[topic] || sentencePools.germany;
          const o = pickRandom(pool.openings);
          const m = pickRandom(pool.mentors);
          const s = pickRandom(pool.specifics);
          const c = pickRandom(pool.closings);
          return `${o} ${m} ${s} ${c}`;
        }

        const starButtons = document.querySelectorAll('.star-btn');
        const ratingStatus = document.getElementById('rating-status');
        const positiveFlow = document.getElementById('positive-flow');
        const negativeFlow = document.getElementById('negative-flow');
        const reviewTextarea = document.getElementById('review-textarea');
        const topicChips = document.querySelectorAll('.topic-chip');
        const shuffleBtn = document.getElementById('shuffle-btn');
        const copyPostBtn = document.getElementById('copy-post-btn');
        const toast = document.getElementById('toast-notify');
        const negativeText = document.getElementById('negative-feedback-text');
        const whatsappDirectorBtn = document.getElementById('whatsapp-director-btn');

        // Initial Generation on page load
        reviewTextarea.value = generateUniqueReview(currentTopic);

        // Star Rating Click Handling
        starButtons.forEach(btn => {
          btn.addEventListener('click', function() {
            const rating = parseInt(this.getAttribute('data-star') || '5', 10);
            currentRating = rating;

            // Render Stars
            starButtons.forEach(b => {
              const r = parseInt(b.getAttribute('data-star') || '5', 10);
              const svg = b.querySelector('svg');
              if (r <= rating) {
                svg.classList.remove('text-slate-300');
                svg.classList.add('text-[#fbbc04]');
              } else {
                svg.classList.remove('text-[#fbbc04]');
                svg.classList.add('text-slate-300');
              }
            });

            // Review Gating Logic
            if (rating >= 4) {
              positiveFlow.classList.remove('hidden');
              negativeFlow.classList.add('hidden');
              ratingStatus.textContent = rating === 5 ? '5.0 • Excellent Experience' : '4.0 • Great Experience';
              ratingStatus.className = 'inline-block mt-1 text-[11px] font-bold text-emerald-700 bg-emerald-50 px-2.5 py-0.5 rounded-full border border-emerald-200';
            } else {
              // 1-3 Stars: Trigger Gating Shield
              positiveFlow.classList.add('hidden');
              negativeFlow.classList.remove('hidden');
              ratingStatus.textContent = rating + '.0 • We Want To Improve';
              ratingStatus.className = 'inline-block mt-1 text-[11px] font-bold text-amber-900 bg-amber-100 px-2.5 py-0.5 rounded-full border border-amber-300';
            }
          });
        });

        // Topic Chip Click
        topicChips.forEach(chip => {
          chip.addEventListener('click', function() {
            topicChips.forEach(c => {
              c.classList.remove('border-[#1a73e8]', 'bg-blue-50', 'text-[#1a73e8]', 'font-semibold');
              c.classList.add('border-slate-200', 'bg-white', 'text-slate-600', 'font-medium');
            });
            this.classList.remove('border-slate-200', 'bg-white', 'text-slate-600', 'font-medium');
            this.classList.add('border-[#1a73e8]', 'bg-blue-50', 'text-[#1a73e8]', 'font-semibold');
            
            currentTopic = this.getAttribute('data-topic') || 'germany';
            // Generate freshly randomized unique review for this topic
            reviewTextarea.value = generateUniqueReview(currentTopic);
          });
        });

        // Shuffle Review Button -> Generates a fresh unique combination
        if (shuffleBtn) {
          shuffleBtn.addEventListener('click', function() {
            reviewTextarea.value = generateUniqueReview(currentTopic);
          });
        }

        // WhatsApp Director Feedback Dynamic Link
        if (negativeText && whatsappDirectorBtn) {
          negativeText.addEventListener('input', function() {
            const userMsg = encodeURIComponent(this.value.trim());
            whatsappDirectorBtn.href = `https://wa.me/919850069600?text=Hello%20Director%20Jayant%20Patil%2C%20I%20visited%20the%20Finesse%20Kolhapur%20office%20and%20had%20feedback%3A%20${userMsg}`;
          });
        }

        // Copy & Post to Google Reviews Button
        if (copyPostBtn) {
          copyPostBtn.addEventListener('click', async function() {
            const textToCopy = reviewTextarea.value.trim();

            // 1. Copy text to clipboard
            try {
              if (navigator.clipboard && navigator.clipboard.writeText) {
                await navigator.clipboard.writeText(textToCopy);
              } else {
                reviewTextarea.select();
                document.execCommand('copy');
              }
            } catch (err) {
              console.warn('Clipboard copy error:', err);
            }

            // 2. Show Toast Notification
            if (toast) {
              toast.classList.remove('opacity-0', 'pointer-events-none');
              toast.classList.add('opacity-100');
            }

            // 3. Open Official Google Review Modal (100% Reliable, Zero 404)
            setTimeout(function() {
              window.open(GOOGLE_REVIEW_MODAL_URL, '_blank');
            }, 600);

            setTimeout(function() {
              if (toast) {
                toast.classList.remove('opacity-100');
                toast.classList.add('opacity-0', 'pointer-events-none');
              }
            }, 3500);
          });
        }

      })();
    </script>

  </body>
</html>
