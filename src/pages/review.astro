---
// src/pages/review.astro
// 👑 GOOGLE-NATIVE ZERO-SCROLL SMART REVIEW FUNNEL & GMB BOOSTER
// 100% Single-Viewport (0 Scroll) Optimized for Mobile
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <title>Rate Finesse Overseas Education on Google</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    
    <!-- Google Fonts: Roboto & Google Material Symbols -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />

    <style>
      * {
        box-sizing: border-box;
        -webkit-tap-highlight-color: transparent;
      }
      html, body {
        height: 100%;
        height: 100dvh;
        margin: 0;
        padding: 0;
        background-color: #ffffff;
        font-family: 'Roboto', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        overflow: hidden;
      }
      .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
      }
      .star-filled {
        font-variation-settings: 'FILL' 1, 'wght' 500, 'GRAD' 0, 'opsz' 36;
        color: #fbbc04 !important;
      }
      .star-empty {
        font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 36;
        color: #dadce0 !important;
      }
    </style>
    
    <!-- Lightweight Tailwind -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script is:inline>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              googleBlue: '#1a73e8',
              googleBlueHover: '#1557b0',
              googleYellow: '#fbbc04',
              googleGreen: '#34a853',
              googleRed: '#ea4335',
              googleGrayBg: '#f8f9fa',
              googleBorder: '#dadce0',
              googleTextMain: '#202124',
              googleTextSub: '#5f6368'
            }
          }
        }
      };
    </script>
  </head>

  <body class="h-[100dvh] w-full flex flex-col justify-between bg-white text-googleTextMain select-none p-3 sm:p-4 max-w-md mx-auto relative">
    
    <!-- 🔝 1. GOOGLE HEADER (COMPACT) -->
    <header class="flex items-center justify-between pb-2 border-b border-googleBorder/60 shrink-0">
      <div class="flex items-center gap-2">
        <!-- Official Google Logo SVG -->
        <svg class="h-5 w-auto" viewBox="0 0 74 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M9.24 10.9V13.84H15.15C14.97 14.86 14.28 16.51 12.24 17.89C10.5 19.06 8.16 19.8 5.4 19.8C2.42 19.8 0 17.38 0 14.4C0 11.42 2.42 9 5.4 9C6.98 9 8.43 9.58 9.55 10.55L11.83 8.35C10.13 6.75 7.95 5.76 5.4 5.76C2.42 5.76 0 8.18 0 11.16C0 14.14 2.42 16.56 5.4 16.56C8.52 16.56 10.6 14.37 10.6 11.25C10.6 10.87 10.56 10.51 10.5 10.16L9.24 10.9Z" fill="#4285F4"/>
          <path d="M23.5 11.16C23.5 14.14 21.08 16.56 18.1 16.56C15.12 16.56 12.7 14.14 12.7 11.16C12.7 8.18 15.12 5.76 18.1 5.76C21.08 5.76 23.5 8.18 23.5 11.16ZM20.7 11.16C20.7 9.3 19.45 8.04 18.1 8.04C16.75 8.04 15.5 9.3 15.5 11.16C15.5 13.02 16.75 14.28 18.1 14.28C19.45 14.28 20.7 13.02 20.7 11.16Z" fill="#EA4335"/>
          <path d="M35.1 11.16C35.1 14.14 32.68 16.56 29.7 16.56C26.72 16.56 24.3 14.14 24.3 11.16C24.3 8.18 26.72 5.76 29.7 5.76C32.68 5.76 35.1 8.18 35.1 11.16ZM32.3 11.16C32.3 9.3 31.05 8.04 29.7 8.04C28.35 8.04 27.1 9.3 27.1 11.16C27.1 13.02 28.35 14.28 29.7 14.28C31.05 14.28 32.3 13.02 32.3 11.16Z" fill="#FBBC05"/>
          <path d="M46.3 6.12V15.78C46.3 19.74 43.96 21.36 40.96 21.36C38.14 21.36 36.46 19.44 35.8 17.94L38.2 16.92C38.62 17.94 39.64 19.08 40.96 19.08C42.7 19.08 43.78 18 43.78 16.02V15.24H43.66C42.82 16.26 41.38 17.16 39.58 17.16C36.7 17.16 34.12 14.64 34.12 11.46C34.12 8.28 36.7 5.76 39.58 5.76C41.38 5.76 42.82 6.66 43.66 7.68H43.78V6.12H46.3ZM43.9 11.46C43.9 9.54 42.7 8.16 41.32 8.16C39.94 8.16 38.8 9.54 38.8 11.46C38.8 13.32 39.94 14.76 41.32 14.76C42.7 14.76 43.9 13.32 43.9 11.46Z" fill="#4285F4"/>
          <path d="M50.2 0H52.9V16.56H50.2V0Z" fill="#34A853"/>
          <path d="M60.6 13.56L62.7 14.94C62.04 15.96 60.6 17.16 58.32 17.16C55.08 17.16 52.8 14.58 52.8 11.46C52.8 8.1 55.14 5.76 58.08 5.76C61.08 5.76 62.7 8.16 63.18 9.66L63.48 10.44L56.16 13.44C56.76 14.64 57.72 15.24 59.1 15.24C60.48 15.24 61.38 14.58 62.04 13.56H60.6ZM55.5 11.28L60.3 9.3C60.06 8.7 59.28 8.04 58.26 8.04C57.06 8.04 55.5 9.12 55.5 11.28Z" fill="#EA4335"/>
        </svg>
        <span class="text-[13px] font-medium text-googleTextSub">Reviews</span>
      </div>
      <div class="flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-googleGrayBg border border-googleBorder text-[11px] font-medium text-googleTextSub">
        <span class="w-2 h-2 rounded-full bg-googleGreen"></span>
        <span>Verified Profile</span>
      </div>
    </header>

    <!-- 🏢 2. FINESSE BUSINESS IDENTITY CARD (COMPACT) -->
    <div class="bg-googleGrayBg rounded-xl p-2.5 border border-googleBorder/80 flex items-center gap-3 shrink-0">
      <div class="w-10 h-10 rounded-lg bg-googleBlue text-white flex items-center justify-center shrink-0 shadow-sm font-bold text-lg">
        🎓
      </div>
      <div class="min-w-0 flex-1">
        <div class="flex items-center gap-1">
          <h1 class="text-sm font-bold text-googleTextMain truncate leading-tight">Finesse Overseas Education</h1>
          <svg class="w-4 h-4 text-googleBlue shrink-0 fill-current" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
        </div>
        <div class="flex items-center gap-1 text-[11px] mt-0.5">
          <span class="font-bold text-googleTextMain">4.7</span>
          <div class="flex text-googleYellow text-[12px] leading-none">
            <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
          </div>
          <span class="text-googleTextSub">(61 Google reviews)</span>
        </div>
        <p class="text-[11px] text-googleTextSub truncate">4th Lane, Rajarampuri, Kolhapur</p>
      </div>
    </div>

    <!-- ⭐ 3. STAR RATING SELECTOR (CENTRAL TOUCHPOINT) -->
    <div class="text-center py-1 shrink-0">
      <p class="text-[12px] font-medium text-googleTextSub mb-1" id="rating-label">Tap stars to rate your consultation:</p>
      <div class="flex items-center justify-center gap-2" id="star-container">
        <button type="button" data-star="1" class="star-btn p-1 transition-transform active:scale-125 focus:outline-none">
          <span class="material-symbols-outlined text-[34px] star-filled">star</span>
        </button>
        <button type="button" data-star="2" class="star-btn p-1 transition-transform active:scale-125 focus:outline-none">
          <span class="material-symbols-outlined text-[34px] star-filled">star</span>
        </button>
        <button type="button" data-star="3" class="star-btn p-1 transition-transform active:scale-125 focus:outline-none">
          <span class="material-symbols-outlined text-[34px] star-filled">star</span>
        </button>
        <button type="button" data-star="4" class="star-btn p-1 transition-transform active:scale-125 focus:outline-none">
          <span class="material-symbols-outlined text-[34px] star-filled">star</span>
        </button>
        <button type="button" data-star="5" class="star-btn p-1 transition-transform active:scale-125 focus:outline-none">
          <span class="material-symbols-outlined text-[34px] star-filled">star</span>
        </button>
      </div>
      <span class="inline-block mt-0.5 text-[11px] font-bold text-googleGreen bg-green-50 px-2 py-0.5 rounded-full border border-green-200" id="rating-status">
        5.0 • Excellent Experience
      </span>
    </div>

    <!-- 🟢 STATE A: 4 & 5 STARS (POSITIVE GOOGLE BOOSTER) -->
    <div id="positive-flow" class="flex flex-col gap-2 flex-1 justify-between min-h-0">
      
      <!-- Quick Service Chips -->
      <div class="shrink-0">
        <div class="flex items-center justify-between mb-1">
          <span class="text-[11px] font-medium text-googleTextSub">Select consultation topic:</span>
          <span class="text-[10px] text-googleBlue font-medium">Auto-updates review</span>
        </div>
        <div class="flex flex-wrap gap-1.5" id="topic-chips">
          <button type="button" data-topic="germany" class="topic-chip px-2.5 py-1 rounded-full text-[11px] font-medium border border-googleBlue bg-blue-50 text-googleBlue flex items-center gap-1 transition-all">
            <span>🇩🇪</span> Germany (₹0 Tuition)
          </button>
          <button type="button" data-topic="italy" class="topic-chip px-2.5 py-1 rounded-full text-[11px] font-medium border border-googleBorder bg-white text-googleTextSub flex items-center gap-1 transition-all">
            <span>🇮🇹</span> Italy Scholarship
          </button>
          <button type="button" data-topic="mbbs" class="topic-chip px-2.5 py-1 rounded-full text-[11px] font-medium border border-googleBorder bg-white text-googleTextSub flex items-center gap-1 transition-all">
            <span>🩺</span> MBBS Europe
          </button>
          <button type="button" data-topic="general" class="topic-chip px-2.5 py-1 rounded-full text-[11px] font-medium border border-googleBorder bg-white text-googleTextSub flex items-center gap-1 transition-all">
            <span>✈️</span> Visa & Guidance
          </button>
        </div>
      </div>

      <!-- Review Text Box (Pre-Filled, Editable, Compact) -->
      <div class="flex-1 flex flex-col justify-between bg-googleGrayBg rounded-xl p-2.5 border border-googleBorder min-h-0">
        <div class="flex items-center justify-between mb-1 shrink-0">
          <span class="text-[11px] font-bold text-googleTextMain flex items-center gap-1">
            <span class="text-googleBlue">✍️</span> Your Google Review:
          </span>
          <button type="button" id="shuffle-btn" class="flex items-center gap-1 px-2 py-0.5 rounded-full bg-white border border-googleBorder hover:border-googleBlue text-googleBlue text-[10px] font-bold transition-all shadow-2xs active:scale-95">
            <span class="material-symbols-outlined text-[12px]">cached</span>
            <span>Shuffle Text</span>
          </button>
        </div>

        <textarea 
          id="review-textarea"
          rows="3"
          class="w-full bg-white rounded-lg p-2 text-xs text-googleTextMain border border-googleBorder/80 focus:border-googleBlue focus:ring-1 focus:ring-googleBlue focus:outline-none resize-none leading-relaxed flex-1"
          placeholder="Write your review..."
        >Best abroad education consultants in Kolhapur! Jayant sir and the team at Rajarampuri gave me 100% genuine guidance for tuition-free German public universities. Highly recommended for genuine study abroad counseling.</textarea>

        <div class="flex items-center justify-between pt-1 text-[10px] text-googleTextSub shrink-0">
          <span>Tap text to edit anytime</span>
          <span class="text-green-700 font-medium">✓ Keywords injected</span>
        </div>
      </div>

      <!-- Primary Action Button: 1-Click Copy & Google Review -->
      <div class="shrink-0 pt-1">
        <button 
          type="button" 
          id="copy-post-btn"
          class="w-full h-11 rounded-full bg-googleBlue hover:bg-googleBlueHover active:scale-[0.98] text-white text-xs sm:text-sm font-bold shadow-md hover:shadow-lg transition-all flex items-center justify-center gap-2"
        >
          <!-- White G Logo -->
          <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#fff"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#fff"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#fff"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#fff"/>
          </svg>
          <span>Copy & Post Review to Google</span>
          <span class="material-symbols-outlined text-[16px]">open_in_new</span>
        </button>
        <p class="text-[10px] text-center text-googleTextSub mt-1">
          Auto-copies text & opens Google Maps review box
        </p>
      </div>

    </div>

    <!-- 🔴 STATE B: 1-3 STARS (REVIEW GATING SHIELD - NEVER GOES TO GOOGLE) -->
    <div id="negative-flow" class="hidden flex-col gap-3 flex-1 justify-between bg-amber-50/70 border border-amber-200 rounded-xl p-3 text-left">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="w-7 h-7 rounded-full bg-amber-100 text-amber-800 flex items-center justify-center font-bold text-sm">⚠️</span>
          <h2 class="text-xs font-bold text-amber-950">We sincerely apologize for falling short.</h2>
        </div>
        <p class="text-[11px] text-amber-900 leading-relaxed">
          Your feedback is critical. Please tell Director <strong class="text-black">Jayant Patil</strong> directly how we can improve your counseling experience.
        </p>
      </div>

      <textarea 
        id="negative-feedback-text" 
        rows="3" 
        class="w-full bg-white rounded-lg p-2 text-xs text-googleTextMain border border-amber-300 focus:outline-none resize-none" 
        placeholder="Please describe what went wrong or how we can resolve this for you..."
      ></textarea>

      <a 
        id="whatsapp-director-btn"
        href="https://wa.me/919850069600?text=Hello%20Director%20Jayant%20Patil%2C%20I%20visited%20the%20Finesse%20Rajarampuri%20office%20and%20wanted%20to%20share%20private%20feedback..."
        target="_blank"
        rel="noopener noreferrer"
        class="w-full h-10 rounded-full bg-[#25D366] hover:bg-[#1EBE5D] text-white text-xs font-bold flex items-center justify-center gap-2 shadow-sm transition-all"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
        <span>Send Private Feedback to Jayant Sir</span>
      </a>
    </div>

    <!-- ⚡ TOAST POPUP (MICRO-INTERACTION) -->
    <div id="toast-notify" class="fixed bottom-16 left-1/2 -translate-x-1/2 bg-[#202124] text-white px-4 py-2 rounded-full text-xs shadow-2xl opacity-0 pointer-events-none transition-all duration-300 flex items-center gap-2 z-50 whitespace-nowrap">
      <span class="w-2 h-2 rounded-full bg-googleGreen animate-ping"></span>
      <span>Review copied! Opening Google Maps...</span>
    </div>

    <!-- 🧠 CLIENT LOGIC: ZERO FRICTION & INSTANT CLIPBOARD + GMB DEEP LINK -->
    <script is:inline>
      (function() {
        // Direct Google Review Write Modal for Finesse Overseas Education
        const GOOGLE_REVIEW_URL = 'https://search.google.com/local/writereview?placeid=ChIJ7-nUWBIAMTsRPQ1LuXeenqE';

        let currentRating = 5;
        let currentTopic = 'germany';
        let reviewIndex = 0;

        // Keyword-injected review variations per topic
        const reviewsData = {
          germany: [
            "Best overseas education consultants in Kolhapur! Jayant sir and the team at Rajarampuri gave me 100% genuine guidance for tuition-free German public universities. Got full clarity on APS and visa. Highly recommended!",
            "Finesse Overseas Education is truly the best study abroad consultant in Kolhapur for Germany. Their engineering guidance for public universities with zero tuition fee is unbeatable. Very honest and transparent staff.",
            "Visited Finesse Rajarampuri office for my Masters in Germany counseling. The team guided me step-by-step for university shortlisting and visa without pushing private colleges. Best consultancy in Kolhapur!"
          ],
          italy: [
            "Top overseas education consultancy in Kolhapur for European scholarships! Finesse handled my complete Italy DSU regional scholarship file with zero hassles. Very transparent and experienced team.",
            "If you want to study in Italy on a 100% scholarship, Finesse Overseas in Rajarampuri is the #1 place in Kolhapur. Jayant sir's strategy for public universities is top notch!",
            "Great experience with Finesse Overseas Education Kolhapur. They explained the entire ISEE Parificato documentation and admission for Italy so clearly. Highly recommended."
          ],
          mbbs: [
            "Best consultants in Kolhapur for MBBS abroad! Finesse provides 100% genuine NMC FMGL compliant universities in Europe. No fake promises, pure factual guidance.",
            "Thank you Finesse Overseas Rajarampuri team for helping me choose an NMC-compliant European medical university. Very trustworthy overseas education consultants in Kolhapur.",
            "The most reliable overseas education consultancy in Kolhapur for medical aspirants. Strict adherence to English medium and licensing rules. Must visit for MBBS abroad!"
          ],
          general: [
            "Undoubtedly the best study abroad & overseas education consultants in Kolhapur. Established guidance at Rajarampuri 4th Lane with 22+ years of expertise. Jayant sir is very knowledgeable.",
            "Finesse Overseas Education Kolhapur provided excellent profile assessment for Europe admissions and visa. Smooth paperwork and genuine advice without high commissions.",
            "Had a wonderful consultation session at Finesse Rajarampuri office. Clear, honest, and student-first abroad education consultancy in Kolhapur. 5/5 stars!"
          ]
        };

        const starButtons = document.querySelectorAll('.star-btn');
        const ratingStatus = document.getElementById('rating-status');
        const positiveFlow = document.getElementById('positive-flow');
        const negativeFlow = document.getElementById('negative-flow');
        const reviewTextarea = document.getElementById('review-textarea');
        const topicChips = document.querySelectorAll('.topic-chip');
        const shuffleBtn = document.getElementById('shuffle-btn');
        const copyPostBtn = document.getElementById('copy-post-btn');
        const toast = document.getElementById('toast-notify');
        const negativeText = document.getElementById('negative-feedback-text');
        const whatsappDirectorBtn = document.getElementById('whatsapp-director-btn');

        function updateReviewText() {
          const list = reviewsData[currentTopic] || reviewsData.germany;
          reviewTextarea.value = list[reviewIndex % list.length];
        }

        // Star Rating Click Handling
        starButtons.forEach(btn => {
          btn.addEventListener('click', function() {
            const rating = parseInt(this.getAttribute('data-star') || '5', 10);
            currentRating = rating;

            // Render Stars
            starButtons.forEach(b => {
              const r = parseInt(b.getAttribute('data-star') || '5', 10);
              const icon = b.querySelector('.material-symbols-outlined');
              if (r <= rating) {
                icon.classList.remove('star-empty');
                icon.classList.add('star-filled');
              } else {
                icon.classList.remove('star-filled');
                icon.classList.add('star-empty');
              }
            });

            // Review Gating Logic
            if (rating >= 4) {
              positiveFlow.classList.remove('hidden');
              negativeFlow.classList.add('hidden');
              ratingStatus.textContent = rating === 5 ? '5.0 • Excellent Experience' : '4.0 • Great Experience';
              ratingStatus.className = 'inline-block mt-0.5 text-[11px] font-bold text-googleGreen bg-green-50 px-2 py-0.5 rounded-full border border-green-200';
            } else {
              // 1-3 Stars: Trigger Gating Shield
              positiveFlow.classList.add('hidden');
              negativeFlow.classList.remove('hidden');
              ratingStatus.textContent = rating + '.0 • We Want To Improve';
              ratingStatus.className = 'inline-block mt-0.5 text-[11px] font-bold text-amber-800 bg-amber-100 px-2 py-0.5 rounded-full border border-amber-300';
            }
          });
        });

        // Topic Chip Click
        topicChips.forEach(chip => {
          chip.addEventListener('click', function() {
            topicChips.forEach(c => {
              c.classList.remove('border-googleBlue', 'bg-blue-50', 'text-googleBlue');
              c.classList.add('border-googleBorder', 'bg-white', 'text-googleTextSub');
            });
            this.classList.remove('border-googleBorder', 'bg-white', 'text-googleTextSub');
            this.classList.add('border-googleBlue', 'bg-blue-50', 'text-googleBlue');
            
            currentTopic = this.getAttribute('data-topic') || 'germany';
            reviewIndex = 0;
            updateReviewText();
          });
        });

        // Shuffle Review Button
        if (shuffleBtn) {
          shuffleBtn.addEventListener('click', function() {
            reviewIndex++;
            updateReviewText();
          });
        }

        // WhatsApp Director Feedback Dynamic Link
        if (negativeText && whatsappDirectorBtn) {
          negativeText.addEventListener('input', function() {
            const userMsg = encodeURIComponent(this.value.trim());
            whatsappDirectorBtn.href = `https://wa.me/919850069600?text=Hello%20Director%20Jayant%20Patil%2C%20I%20visited%20the%20Finesse%20Kolhapur%20office%20and%20had%20feedback%3A%20${userMsg}`;
          });
        }

        // Copy & Post to Google Reviews Button
        if (copyPostBtn) {
          copyPostBtn.addEventListener('click', async function() {
            const textToCopy = reviewTextarea.value.trim();

            // 1. Copy text to clipboard
            try {
              if (navigator.clipboard && navigator.clipboard.writeText) {
                await navigator.clipboard.writeText(textToCopy);
              } else {
                // Fallback for older mobile webviews
                reviewTextarea.select();
                document.execCommand('copy');
              }
            } catch (err) {
              console.warn('Clipboard copy error:', err);
            }

            // 2. Show Toast Notification
            if (toast) {
              toast.classList.remove('opacity-0', 'pointer-events-none');
              toast.classList.add('opacity-100');
            }

            // 3. Open Google Maps Write Review Modal
            setTimeout(function() {
              window.open(GOOGLE_REVIEW_URL, '_blank');
            }, 600);

            setTimeout(function() {
              if (toast) {
                toast.classList.remove('opacity-100');
                toast.classList.add('opacity-0', 'pointer-events-none');
              }
            }, 3500);
          });
        }

      })();
    </script>

  </body>
</html>
