---
// src/pages/intelligence/[...page].astro
// 👑 THE MASTERPIECE EDITORIAL HUB: Symmetrical High-Trust Grid, Smart Search & Diagnostic Terminal
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import IntelligenceRadar from '../../components/IntelligenceRadar.astro';
import Footer from '../../components/Footer.astro';
import MythBusterFlip from '../../components/MythBusterFlip.astro';
import SafetyScoreQuiz from '../../components/SafetyScoreQuiz.astro';
import RedNoticeAlert from '../../components/RedNoticeAlert.astro';
import LeadCaptureModal from '../../components/LeadCaptureModal';

export const prerender = true;

export async function getStaticPaths({ paginate }) {
  const allPosts = await getCollection('intelligence');
  const sortedPosts = allPosts.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
  return paginate(sortedPosts, { pageSize: 12 });
}

const { page = { data: [], url: {}, currentPage: 1, lastPage: 1 } } = Astro.props;

// Filter Topic Categories
const filterTabs = [
  { label: 'All Audits', value: 'all', icon: '🌐' },
  { label: 'Germany Zero Tuition', value: 'germany', icon: '🇩🇪' },
  { label: 'Italy Scholarships', value: 'italy', icon: '🇮🇹' },
  { label: 'Austria Admissions', value: 'austria', icon: '🇦🇹' },
  { label: 'MBBS & NMC Rules', value: 'medical', icon: '🩺' },
  { label: 'Financial Truths', value: 'financial', icon: '⚠️' }
];

const seoTitle = "Finesse Intelligence Hub | NMC Alerts & MBBS Abroad Audits";
const seoDescription = "Deep-dive econometric research, NMC compliance updates, and financial exposes for Indian students planning European university admissions.";

// Knowledge Graph Schema
const itemListElement = page.data.map((post, index) => ({
  "@type": "ListItem",
  "position": index + 1,
  "url": `${Astro.site}intelligence/${post.id.split('.')[0]}`,
  "name": post.data.title,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `${Astro.site}intelligence/${post.id.split('.')[0]}`
  }
}));

const listSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": seoTitle,
  "description": seoDescription,
  "itemListElement": itemListElement
});

// Symmetrical 3x3 Grid Distribution (3 cards + Lead Magnet + 6 cards = 9 posts with zero empty gaps)
const firstGridPosts = page.data.slice(0, 3);
const secondGridPosts = page.data.slice(3);
---

<Layout title={seoTitle} description={seoDescription} schema={listSchema}>
  
  <IntelligenceRadar />

  <!-- The Sovereign Audit Vaults Main Stream -->
  <section class="py-16 md:py-24 bg-[#FAFAFA] relative overflow-hidden" id="audit-vaults">
    <div class="container mx-auto px-4 lg:px-8 max-w-7xl relative z-10">
      
      <!-- Sticky Smart Toolbar (Search + Country Tabs) -->
      <div class="bg-white border border-slate-200/90 rounded-3xl p-6 md:p-8 shadow-sm mb-12 relative z-30">
        
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 pb-6 border-b border-slate-100">
          <div>
            <span class="text-emerald-700 text-xs font-mono font-bold uppercase tracking-widest flex items-center gap-1.5 mb-1">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              Investigation Repository
            </span>
            <h2 class="text-2xl md:text-3xl font-serif text-slate-900 font-medium tracking-tight">
              The Sovereign Audit Vaults
            </h2>
          </div>

          <!-- Instant Live Search Bar -->
          <div class="w-full lg:w-[420px]">
            <div class="relative">
              <input 
                type="text" 
                id="audit-search-input" 
                placeholder="Search by topic, university, NMC rules, country..." 
                class="w-full bg-slate-50 border border-slate-200 focus:bg-white hover:border-slate-300 focus:border-emerald-600 focus:ring-2 focus:ring-emerald-500/20 rounded-2xl pl-11 pr-10 py-3 text-sm text-slate-900 placeholder:text-slate-400 shadow-inner transition-all focus:outline-none"
              />
              <svg class="w-4 h-4 text-slate-400 absolute left-4 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
              <button 
                id="clear-search-btn" 
                class="hidden absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 text-xs font-bold bg-slate-200 hover:bg-slate-300 rounded-full w-5 h-5 flex items-center justify-center transition-all cursor-pointer"
                title="Clear search"
              >
                ✕
              </button>
            </div>
          </div>
        </div>

        <!-- Segmented Filter Tabs & Live Counter -->
        <div class="flex flex-wrap items-center justify-between gap-4 pt-6">
          <div class="flex flex-wrap gap-2" id="filter-tabs-container">
            {filterTabs.map((tab) => (
              <button
                data-filter-tab={tab.value}
                class={`filter-tab-btn px-4 py-2 rounded-xl text-xs font-bold tracking-wide transition-all duration-300 cursor-pointer flex items-center gap-1.5 ${
                  tab.value === 'all' 
                  ? 'bg-slate-900 text-white shadow-sm' 
                  : 'bg-slate-100 hover:bg-slate-200/80 text-slate-700'
                }`}
              >
                <span>{tab.icon}</span>
                <span>{tab.label}</span>
              </button>
            ))}
          </div>

          <div class="text-xs font-mono text-slate-500">
            Showing <span class="font-bold text-slate-900" id="visible-count">{page.data.length}</span> of {page.data.length} Investigations
          </div>
        </div>

      </div>

      <!-- No Results Feedback State -->
      <div id="no-results-box" class="hidden p-12 text-center bg-white border border-slate-200 rounded-3xl shadow-sm my-8">
        <div class="w-12 h-12 rounded-full bg-amber-50 border border-amber-200 text-amber-600 flex items-center justify-center mx-auto mb-4">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
        </div>
        <h3 class="text-lg font-serif text-slate-900 font-medium mb-2">No Matching Audits Found</h3>
        <p class="text-slate-500 text-sm max-w-md mx-auto mb-6">We couldn't find any reports matching your search query. Try another keyword or reset the category filter.</p>
        <button id="reset-all-filters-btn" class="px-5 py-2.5 bg-slate-900 text-white rounded-xl text-xs font-bold hover:bg-slate-800 transition-all cursor-pointer">
          Reset All Filters
        </button>
      </div>

      <div id="audit-stream-container" class="space-y-12">
        
        <!-- SECTION 1: 3-Column Modern Editorial Magazine Grid (Row 1) -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
          {firstGridPosts.map((post) => {
            const slug = post.id.split('.')[0];
            const totalWords = typeof post.body === "string" ? post.body.trim().split(/\s+/).filter(Boolean).length : 0;
            const readTime = Math.max(3, Math.ceil(totalWords / 200));

            return (
              <article 
                data-category={post.data.category}
                data-title={post.data.title.toLowerCase()}
                data-excerpt={(post.data.excerpt || "").toLowerCase()}
                data-slug={slug}
                class="audit-card group bg-white border border-slate-200/90 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl hover:border-emerald-500/60 hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between"
              >
                <div>
                  <a href={`/intelligence/${slug}`} class="block relative h-52 w-full overflow-hidden bg-slate-100 finesse-master-anchor" data-gtm-title={post.data.title} data-gtm-slug={slug}>
                    {post.data.coverImage ? (
                      <img 
                        src={post.data.coverImage.src} 
                        alt={post.data.title} 
                        class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                        loading="lazy"
                      />
                    ) : (
                      <div class="w-full h-full bg-slate-200"></div>
                    )}
                    
                    <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div>

                    <span class="absolute top-4 left-4 z-20 bg-white/95 backdrop-blur-md text-slate-800 text-[10px] font-bold uppercase tracking-wider px-3 py-1 rounded-full border border-slate-200 shadow-sm">
                      {post.data.category}
                    </span>
                  </a>

                  <div class="p-6">
                    <a href={`/intelligence/${slug}`} class="block group-hover:text-emerald-700 transition-colors">
                      <h3 class="text-lg font-serif text-slate-900 font-medium leading-snug mb-3 line-clamp-2">
                        {post.data.title}
                      </h3>
                    </a>
                    <p class="text-xs sm:text-sm text-slate-600 line-clamp-3 leading-relaxed font-normal mb-4">
                      {post.data.excerpt}
                    </p>
                  </div>
                </div>

                <div class="px-6 pb-6 pt-4 border-t border-slate-100 flex items-center justify-between mt-auto">
                  <div class="flex items-center gap-2">
                    <span class="text-[10px] font-mono text-slate-400">{readTime}m read</span>
                  </div>
                  <a href={`/intelligence/${slug}`} class="text-xs font-bold text-emerald-700 group-hover:text-emerald-800 flex items-center gap-1">
                    Read Audit <span class="group-hover:translate-x-1 transition-transform">→</span>
                  </a>
                </div>
              </article>
            );
          })}
        </div>

        <!-- SECTION 2: Inline High-Authority Lead Magnet Banner (Mid-Stream) -->
        <div class="p-8 md:p-12 bg-gradient-to-br from-slate-900 via-slate-950 to-slate-900 text-white rounded-3xl shadow-xl border border-slate-800 relative overflow-hidden">
          <div class="absolute -right-20 -top-20 w-80 h-80 bg-emerald-500/20 blur-[80px] rounded-full pointer-events-none"></div>
          
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative z-10">
            <div class="lg:col-span-8">
              <span class="inline-block px-3 py-1 bg-emerald-500/20 text-emerald-300 text-[10px] font-mono font-bold uppercase tracking-widest rounded-md border border-emerald-500/30 mb-4">
                Statutory Due Diligence Tool
              </span>
              <h3 class="text-2xl md:text-3xl font-serif text-white font-medium mb-3 leading-tight">
                Download the Official NMC Foreign Medical Graduate Checklist (2026)
              </h3>
              <p class="text-slate-300 text-sm md:text-base leading-relaxed max-w-2xl font-normal">
                Avoid blacklisted universities and fake English-medium traps. Verify any European or abroad university against all 7 mandatory NMC gazette regulations before paying admission fees.
              </p>
            </div>

            <div class="lg:col-span-4 flex flex-col justify-center">
              <LeadCaptureModal client:load pdfUrl="/finesse-nmc-guidelines-checklist.pdf" />
              <p class="text-[11px] font-mono text-slate-400 text-center mt-3">Free instant download • 100% Verified PDF</p>
            </div>
          </div>
        </div>

        <!-- SECTION 3: 3-Column Modern Editorial Magazine Grid (Rows 2 & 3 - 6 Cards) -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
          {secondGridPosts.map((post) => {
            const slug = post.id.split('.')[0];
            const totalWords = typeof post.body === "string" ? post.body.trim().split(/\s+/).filter(Boolean).length : 0;
            const readTime = Math.max(3, Math.ceil(totalWords / 200));

            return (
              <article 
                data-category={post.data.category}
                data-title={post.data.title.toLowerCase()}
                data-excerpt={(post.data.excerpt || "").toLowerCase()}
                data-slug={slug}
                class="audit-card group bg-white border border-slate-200/90 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl hover:border-emerald-500/60 hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between"
              >
                <div>
                  <a href={`/intelligence/${slug}`} class="block relative h-52 w-full overflow-hidden bg-slate-100 finesse-master-anchor" data-gtm-title={post.data.title} data-gtm-slug={slug}>
                    {post.data.coverImage ? (
                      <img 
                        src={post.data.coverImage.src} 
                        alt={post.data.title} 
                        class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                        loading="lazy"
                      />
                    ) : (
                      <div class="w-full h-full bg-slate-200"></div>
                    )}
                    
                    <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div>

                    <span class="absolute top-4 left-4 z-20 bg-white/95 backdrop-blur-md text-slate-800 text-[10px] font-bold uppercase tracking-wider px-3 py-1 rounded-full border border-slate-200 shadow-sm">
                      {post.data.category}
                    </span>
                  </a>

                  <div class="p-6">
                    <a href={`/intelligence/${slug}`} class="block group-hover:text-emerald-700 transition-colors">
                      <h3 class="text-lg font-serif text-slate-900 font-medium leading-snug mb-3 line-clamp-2">
                        {post.data.title}
                      </h3>
                    </a>
                    <p class="text-xs sm:text-sm text-slate-600 line-clamp-3 leading-relaxed font-normal mb-4">
                      {post.data.excerpt}
                    </p>
                  </div>
                </div>

                <div class="px-6 pb-6 pt-4 border-t border-slate-100 flex items-center justify-between mt-auto">
                  <div class="flex items-center gap-2">
                    <span class="text-[10px] font-mono text-slate-400">{readTime}m read</span>
                  </div>
                  <a href={`/intelligence/${slug}`} class="text-xs font-bold text-emerald-700 group-hover:text-emerald-800 flex items-center gap-1">
                    Read Audit <span class="group-hover:translate-x-1 transition-transform">→</span>
                  </a>
                </div>
              </article>
            );
          })}
        </div>

      </div>

      <!-- Pagination Matrix -->
      <div class="mt-16 pt-8 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4 font-sans">
        {page?.url?.prev ? (
          <a 
            href={page?.url?.prev} 
            data-gtm-pagination-dir="newer" 
            class="px-5 py-2.5 bg-white hover:bg-slate-50 text-slate-700 hover:text-emerald-700 border border-slate-200 rounded-xl transition-all font-bold text-xs tracking-wider flex items-center gap-2 shadow-sm"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
            Newer Audits
          </a>
        ) : (
          <div class="w-28 hidden sm:block"></div>
        )}

        <span class="text-slate-600 text-xs font-mono font-bold uppercase tracking-wider bg-white px-4 py-2 rounded-lg border border-slate-200 shadow-sm">
          Page {page?.currentPage} <span class="text-slate-300 mx-1">/</span> {page?.lastPage}
        </span>

        {page?.url?.next ? (
          <a 
            href={page?.url?.next} 
            data-gtm-pagination-dir="older" 
            class="px-5 py-2.5 bg-white hover:bg-slate-50 text-slate-700 hover:text-emerald-700 border border-slate-200 rounded-xl transition-all font-bold text-xs tracking-wider flex items-center gap-2 shadow-sm"
          >
            Older Audits
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </a>
        ) : (
          <div class="w-28 hidden sm:block"></div>
        )}
      </div>

    </div>
  </section>

  <!-- Educational Truth Matrix (Light Editorial Flow) -->
  <MythBusterFlip />

  <!-- Executive Diagnostic & Action Hub (Unified Dark Terminal) -->
  <div class="bg-slate-950 border-t border-slate-800/80">
    <SafetyScoreQuiz />
    <RedNoticeAlert />
  </div>

  <Footer theme="light" hideCTA={true} />

</Layout>

<script>
  // ⚡ SMART REAL-TIME SEARCH & TABBED FILTERING ENGINE
  document.addEventListener('DOMContentLoaded', () => {
    const tabBtns = document.querySelectorAll('.filter-tab-btn');
    const cards = document.querySelectorAll('.audit-card');
    const searchInput = document.getElementById('audit-search-input') as HTMLInputElement;
    const clearSearchBtn = document.getElementById('clear-search-btn');
    const visibleCountEl = document.getElementById('visible-count');
    const noResultsBox = document.getElementById('no-results-box');
    const resetAllBtn = document.getElementById('reset-all-filters-btn');

    let currentTab = 'all';
    let searchQuery = '';

    function applyFilters() {
      let visibleCount = 0;
      const q = searchQuery.trim().toLowerCase();

      cards.forEach((card) => {
        const cardEl = card as HTMLElement;
        const cat = (card.getAttribute('data-category') || '').toLowerCase();
        const title = (card.getAttribute('data-title') || '').toLowerCase();
        const excerpt = (card.getAttribute('data-excerpt') || '').toLowerCase();
        const slug = (card.getAttribute('data-slug') || '').toLowerCase();

        // Topic Tab matching logic
        let matchesTab = false;
        if (currentTab === 'all') {
          matchesTab = true;
        } else if (currentTab === 'germany') {
          matchesTab = title.includes('germany') || excerpt.includes('germany') || slug.includes('germany');
        } else if (currentTab === 'italy') {
          matchesTab = title.includes('italy') || excerpt.includes('italy') || slug.includes('italy') || title.includes('isee');
        } else if (currentTab === 'austria') {
          matchesTab = title.includes('austria') || excerpt.includes('austria') || slug.includes('austria') || title.includes('vienna');
        } else if (currentTab === 'medical') {
          matchesTab = title.includes('mbbs') || title.includes('neet') || title.includes('nmc') || excerpt.includes('nmc') || slug.includes('neet') || slug.includes('mbbs');
        } else if (currentTab === 'financial') {
          matchesTab = cat.includes('financial') || title.includes('scam') || title.includes('toll') || excerpt.includes('cost');
        }

        // Search query matching
        const matchesSearch = !q || title.includes(q) || excerpt.includes(q) || cat.includes(q) || slug.includes(q);

        if (matchesTab && matchesSearch) {
          cardEl.style.display = 'flex';
          visibleCount++;
        } else {
          cardEl.style.display = 'none';
        }
      });

      if (visibleCountEl) visibleCountEl.textContent = String(visibleCount);

      if (noResultsBox) {
        if (visibleCount === 0) {
          noResultsBox.classList.remove('hidden');
        } else {
          noResultsBox.classList.add('hidden');
        }
      }
    }

    // Filter tab button handler
    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const selected = btn.getAttribute('data-filter-tab') || 'all';
        currentTab = selected;

        tabBtns.forEach(b => {
          b.classList.remove('bg-slate-900', 'text-white', 'shadow-sm');
          b.classList.add('bg-slate-100', 'text-slate-700');
        });

        btn.classList.add('bg-slate-900', 'text-white', 'shadow-sm');
        btn.classList.remove('bg-slate-100', 'text-slate-700');

        applyFilters();
      });
    });

    // Live search input handler
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = (e.target as HTMLInputElement).value;
        if (clearSearchBtn) {
          if (searchQuery.length > 0) {
            clearSearchBtn.classList.remove('hidden');
          } else {
            clearSearchBtn.classList.add('hidden');
          }
        }
        applyFilters();
      });
    }

    // Clear search button
    if (clearSearchBtn && searchInput) {
      clearSearchBtn.addEventListener('click', () => {
        searchInput.value = '';
        searchQuery = '';
        clearSearchBtn.classList.add('hidden');
        searchInput.focus();
        applyFilters();
      });
    }

    // Reset all filters button
    if (resetAllBtn && searchInput) {
      resetAllBtn.addEventListener('click', () => {
        searchInput.value = '';
        searchQuery = '';
        currentTab = 'all';
        if (clearSearchBtn) clearSearchBtn.classList.add('hidden');

        tabBtns.forEach(b => {
          if (b.getAttribute('data-filter-tab') === 'all') {
            b.classList.add('bg-slate-900', 'text-white', 'shadow-sm');
            b.classList.remove('bg-slate-100', 'text-slate-700');
          } else {
            b.classList.remove('bg-slate-900', 'text-white');
            b.classList.add('bg-slate-100', 'text-slate-700');
          }
        });

        applyFilters();
      });
    }

    // GTM tracking
    const masterAnchors = document.querySelectorAll('.finesse-master-anchor');
    masterAnchors.forEach(anchor => {
      anchor.addEventListener('click', () => {
        const auditTitle = anchor.getAttribute('data-gtm-title');
        const auditSlug = anchor.getAttribute('data-gtm-slug');
        if (typeof window !== 'undefined' && (window as any).dataLayer) {
          (window as any).dataLayer.push({
            'event': 'blog_card_click',
            'blog_title': auditTitle,
            'blog_slug': auditSlug
          });
        }
      });
    });

  });
</script>