---
// File: src/pages/intelligence/[slug].astro
// 👑 MASTERPIECE EDITORIAL EDITION: World-Class Think-Tank & Academic Journal Layout
// Pixel-Perfect Container Alignment, 100% Light Luxury Theme, Responsive Tables & E-E-A-T Compliance

import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import LeadCaptureModal from "../../components/LeadCaptureModal";

export const prerender = true;

// 1. Dynamic Routing Engine Setup
export async function getStaticPaths() {
  const posts = await getCollection("intelligence");
  return posts.map((post) => {
    const slugName = post.id.split(".")[0];
    return {
      params: { slug: slugName },
      props: { post },
    };
  });
}

const { post } = Astro.props;

if (!post) {
  return new Response(null, {
    status: 404,
    statusText: "Not Found",
  });
}

// 2. Guaranteed 2 Related Posts Engine (Zero Empty Gaps)
const allPosts = await getCollection("intelligence");
let relatedPosts = allPosts
  .filter((p) => p.id !== post.id && p.data.category === post.data.category)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

// If fewer than 2 in the same category, backfill from other categories
if (relatedPosts.length < 2) {
  const others = allPosts
    .filter((p) => p.id !== post.id && !relatedPosts.some((r) => r.id === p.id))
    .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
  relatedPosts = [...relatedPosts, ...others].slice(0, 2);
} else {
  relatedPosts = relatedPosts.slice(0, 2);
}

// 3. Render Markdown Content & Headings
let Content: any = null;
let headings: any[] = [];
try {
  const renderedResult = await render(post);
  Content = renderedResult.Content;
  headings = renderedResult.headings ?? [];
} catch (e) {
  console.error("🚨 Render failed for slug:", post.id, e);
}

const filteredHeadings = headings
  ? headings.filter((h) => h.depth > 1 && h.depth < 4)
  : [];

// 4. Date & Reading Time Calculations
const publishDate = new Date(post.data.publishDate);
const finalModifiedDate = post.data.lastModifiedDate
  ? new Date(post.data.lastModifiedDate)
  : publishDate;

const formattedDate = publishDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const formattedModifiedDate = finalModifiedDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const bodyText = typeof post.body === "string" ? post.body : "";
const wordCount = bodyText.trim().split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(3, Math.ceil(wordCount / 200));

const slugPath = post.id.split(".")[0];
const canonicalURL = new URL(`/intelligence/${slugPath}`, Astro.site).href;
const coverImageAbsURL = post.data.coverImage?.src
  ? new URL(post.data.coverImage.src, Astro.site).href
  : undefined;

// 5. Schema.org Structured Data
const articleSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "TechArticle",
      "@id": `${canonicalURL}#article`,
      isPartOf: { "@id": canonicalURL },
      headline: post.data.title,
      description: post.data.excerpt,
      ...(coverImageAbsURL && { image: coverImageAbsURL }),
      datePublished: publishDate.toISOString(),
      dateModified: finalModifiedDate.toISOString(),
      timeRequired: `PT${readingTime}M`,
      author: {
        "@type": "Person",
        name: post.data.author || "Mr. Jayant Patil",
        jobTitle: post.data.authorRole || "Founder & CEO",
        url: `${Astro.site}#organization`,
      },
      publisher: {
        "@id": `${Astro.site}#organization`,
      },
      abstract: post.data.keyTakeaways?.join(" ") || post.data.excerpt,
    },
    {
      "@type": "WebPage",
      "@id": canonicalURL,
      url: canonicalURL,
      name: `${post.data.title} | Finesse Audit Vault`,
      description: post.data.excerpt,
      breadcrumb: {
        "@type": "BreadcrumbList",
        itemListElement: [
          {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item: Astro.url.origin,
          },
          {
            "@type": "ListItem",
            position: 2,
            name: "Intelligence Hub",
            item: `${Astro.url.origin}/intelligence`,
          },
          {
            "@type": "ListItem",
            position: 3,
            name: post.data.title,
            item: canonicalURL,
          },
        ],
      },
    },
  ],
});

// 6. Dynamic Verification Citations
const categoryUpper = (post.data.category ?? '').toUpperCase();
let references = [
  { name: "Schengen Visa Information Portal", url: "https://www.schengenvisainfo.com/", description: "Official European Schengen Zone travel & student visa regulations database." },
  { name: "UNESCO Global Recognition Convention", url: "https://www.unesco.org/en/education/higher-education/global-convention", description: "Global convention on recognition of higher education qualifications." }
];

if (post.id.includes('scams-guide') || categoryUpper.includes('EXPOSÉ') || categoryUpper.includes('EXPOSE')) {
  references = [
    { name: "National Medical Commission (NMC) India", url: "https://www.nmc.org.in/", description: "Official regulatory body for medical education standards & FMGL Gazette regulations." },
    { name: "DAAD Germany (German Academic Exchange Service)", url: "https://www.daad.de/en/", description: "Official German national agency for international academic exchange & degree database." },
    { name: "Universitaly Portal (Ministry of Universities & Research)", url: "https://www.universitaly.it/", description: "Official portal of the Italian government for international university pre-enrollment." },
    { name: "German Federal Foreign Office (Auswärtiges Amt)", url: "https://www.auswaertiges-amt.de/en", description: "Official federal office specifying Blocked Account rates & national student visa rules." },
    { name: "Italian Ministry of Foreign Affairs (Esteri)", url: "https://www.esteri.it/en/", description: "Official guidelines for national study visas and regional DSU scholarship directives." },
    { name: "National Board of Examinations (NBE)", url: "https://natboard.edu.in/", description: "Official board administering FMGE Screening Test & NExT licensing exams." }
  ];
} else if (categoryUpper.includes('NMC') || categoryUpper.includes('MBBS') || post.id.includes('nmc')) {
  references = [
    { name: "National Medical Commission (NMC) India", url: "https://www.nmc.org.in/", description: "Official regulatory body for medical education standards & FMGL Gazette regulations." },
    { name: "Ministry of Health & Family Welfare, Govt of India", url: "https://www.mohfw.gov.in/", description: "Union ministerial guidelines and official circulars for foreign medical graduates." },
    { name: "National Board of Examinations (NBE)", url: "https://natboard.edu.in/", description: "Official board administering FMGE Screening Test & NExT licensing exams." }
  ];
} else if (categoryUpper.includes('GERMANY') || post.id.includes('germany')) {
  references = [
    { name: "DAAD Germany (German Academic Exchange Service)", url: "https://www.daad.de/en/", description: "Official German national agency for international academic exchange & degree database." },
    { name: "German Federal Foreign Office (Auswärtiges Amt)", url: "https://www.auswaertiges-amt.de/en", description: "Official federal office specifying Blocked Account rates & national student visa rules." },
    { name: "uni-assist e.V. Germany", url: "https://www.uni-assist.de/en/", description: "Centralized service for evaluating international school/university credentials." }
  ];
} else if (categoryUpper.includes('ITALY') || post.id.includes('italy')) {
  references = [
    { name: "Universitaly Portal (Ministry of Universities & Research)", url: "https://www.universitaly.it/", description: "Official portal of the Italian government for international university pre-enrollment." },
    { name: "Italian Ministry of Foreign Affairs (Esteri)", url: "https://www.esteri.it/en/", description: "Official guidelines for national study visas and regional DSU scholarship directives." },
    { name: "INPS (Istituto Nazionale Previdenza Sociale)", url: "https://www.inps.it/", description: "Official social security database regulating ISEE parificato calculations." }
  ];
} else if (categoryUpper.includes('AUSTRIA') || post.id.includes('austria')) {
  references = [
    { name: "OeAD Austria (Agency for Education and Internationalisation)", url: "https://oead.at/en/", description: "Official Austrian national agency for international academic mobility and cooperation." },
    { name: "Austrian Federal Ministry of Education, Science and Research (BMBWF)", url: "https://www.bmbwf.gv.at/en.html", description: "Official ministerial body regulating higher education institutions in Austria." },
    { name: "Austrian Federal Ministry of European and International Affairs (BMEIA)", url: "https://www.bmeia.gv.at/en/", description: "Official ministry detailing Austrian student visas, residence permits & D-visa requirements." }
  ];
}

const authorInitials = post.data.author
  ? post.data.author.split(' ').map((n: string) => n[0]).join('').toUpperCase()
  : 'JP';
---

<Layout
  title={`${post.data.title} | Finesse Audit Vault`}
  description={post.data.excerpt}
  image={post.data.coverImage?.src}
  canonical={canonicalURL}
  schema={articleSchema}
>
  {/* ⏳ Reading Progress Bar */}
  <div
    id="progress-bar"
    class="fixed top-0 left-0 h-1 bg-emerald-600 z-[99999] w-0 transition-all duration-150 ease-out"
  >
  </div>

  {/* 📣 Floating Share Bar (Sleek Desktop Light Edition) */}
  <div
    class="fixed bottom-6 right-6 lg:bottom-10 lg:right-10 z-[9999] flex flex-col gap-2.5 bg-white/95 backdrop-blur-xl p-2 rounded-full border border-slate-200 shadow-xl"
  >
    <button
      id="share-wa"
      class="w-11 h-11 flex items-center justify-center rounded-full bg-[#25D366] text-white hover:scale-105 transition-transform shadow-md cursor-pointer"
      aria-label="Share on WhatsApp"
      title="Share on WhatsApp"
    >
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
        <path
          d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
        />
      </svg>
    </button>
    <button
      id="share-copy"
      class="w-11 h-11 flex items-center justify-center rounded-full bg-slate-100 text-slate-700 hover:bg-slate-900 hover:text-white transition-all shadow-md cursor-pointer"
      aria-label="Copy Article Link"
      title="Copy Link"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2.2"
          d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"
        />
      </svg>
    </button>
  </div>

  <main class="w-full bg-[#FAFAFA] min-h-screen font-sans" id="core-article-container" data-slug={slugPath}>
    
    {/* Page Header Deck (Consistent Max-W-7xl Alignment Across Entire Page) */}
    <header class="border-b border-slate-200/90 bg-white pt-28 sm:pt-32 pb-10 sm:pb-14 relative overflow-hidden">
      <div class="absolute inset-0 bg-[linear-gradient(rgba(15,23,42,0.015)_1px,transparent_1px),linear-gradient(90deg,rgba(15,23,42,0.015)_1px,transparent_1px)] bg-[size:32px_32px] pointer-events-none"></div>
      
      <div class="container mx-auto px-4 lg:px-8 max-w-7xl relative z-10">
        
        {/* Navigation Breadcrumb */}
        <nav
          class="flex flex-wrap items-center gap-2 text-[11px] font-mono font-bold uppercase tracking-wider text-slate-400 mb-6"
          aria-label="Breadcrumb"
        >
          <a href="/" class="hover:text-emerald-700 transition-colors">Home</a>
          <span>/</span>
          <a href="/intelligence" class="hover:text-emerald-700 transition-colors">Intelligence Hub</a>
          <span>/</span>
          <span class="text-emerald-800 bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200/80 font-semibold">
            {post.data.category}
          </span>
        </nav>

        {/* Title */}
        <h1
          class="text-3xl sm:text-4xl md:text-5xl lg:text-[3.25rem] font-serif text-slate-900 font-medium leading-[1.18] tracking-tight mb-6 max-w-5xl"
        >
          {post.data.title}
        </h1>

        {/* Excerpt Briefing */}
        {post.data.excerpt && (
          <p class="text-slate-600 text-base sm:text-lg md:text-xl font-normal leading-relaxed mb-8 max-w-5xl">
            {post.data.excerpt}
          </p>
        )}

        {/* Metadata Byline Strip */}
        <div
          class="flex flex-wrap items-center justify-between gap-4 pt-6 border-t border-slate-100 text-xs text-slate-500 font-sans max-w-5xl"
        >
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-emerald-50 border border-emerald-200 flex items-center justify-center text-emerald-800 text-xs font-bold shadow-xs">
              {authorInitials}
            </div>
            <div>
              <p class="text-slate-900 font-bold leading-tight">
                {post.data.author || 'Mr. Jayant Patil'}
              </p>
              <p class="text-[10px] font-mono text-slate-400 uppercase tracking-wider">
                {post.data.authorRole || 'Founder & CEO'}
              </p>
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-4 text-xs font-mono">
            <div class="flex items-center gap-1.5 text-slate-500">
              <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <span>{formattedDate}</span>
            </div>

            {post.data.lastModifiedDate && (
              <div class="flex items-center gap-1.5 text-emerald-700 bg-emerald-50 px-2.5 py-0.5 rounded border border-emerald-200 font-bold">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                <span>Updated: {formattedModifiedDate}</span>
              </div>
            )}

            <div class="flex items-center gap-1.5 text-slate-600 bg-slate-100 px-2.5 py-0.5 rounded-md font-bold">
              <svg class="w-3.5 h-3.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>{readingTime} Min Read</span>
            </div>
          </div>
        </div>

      </div>
    </header>

    {/* Content Layout (Consistent max-w-7xl) */}
    <section class="container mx-auto px-4 lg:px-8 max-w-7xl py-10 lg:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
        
        {/* Left Column: Markdown Article Body (8 Cols) */}
        <article class="lg:col-span-8 audit-content w-full min-w-0">
          
          {/* Main Top Cover Image */}
          {post.data.coverImage && (
            <div class="mb-10 w-full rounded-3xl overflow-hidden border border-slate-200/90 shadow-sm bg-slate-100">
              <img
                src={post.data.coverImage.src}
                alt={post.data.coverImageAlt || post.data.title}
                class="w-full h-auto max-h-[480px] object-cover hover:scale-102 transition-transform duration-700"
                decoding="async"
              />
            </div>
          )}

          {/* Executive Summary Bento Box (100% Light Luxury Editorial) */}
          {(post.data.keyTakeaways?.length > 0 || post.data.moneyPageLink) && (
            <section
              class="mb-12 rounded-3xl border border-emerald-200/80 bg-gradient-to-br from-emerald-50/40 via-white to-emerald-50/20 p-6 sm:p-8 shadow-sm font-sans"
              aria-label="Executive Intelligence Payload"
            >
              <div class="flex items-center gap-2 mb-4 pb-3 border-b border-emerald-100">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-600 animate-pulse"></span>
                <h2
                  class="text-xs font-mono font-bold uppercase tracking-widest text-emerald-900 m-0 p-0 border-none"
                >
                  Executive Takeaways & Audited Summary
                </h2>
              </div>

              {post.data.keyTakeaways && post.data.keyTakeaways.length > 0 && (
                <ul class="space-y-3.5 m-0 p-0 list-none mb-6">
                  {post.data.keyTakeaways.map((takeaway: string) => (
                    <li class="flex items-start gap-3 m-0 p-0 text-sm sm:text-base text-slate-800 leading-relaxed font-normal">
                      <span class="mt-2 shrink-0 w-1.5 h-1.5 rounded-full bg-emerald-600 block"></span>
                      <span>{takeaway}</span>
                    </li>
                  ))}
                </ul>
              )}

              {post.data.moneyPageLink && (
                <div class="pt-4 border-t border-emerald-100/80 flex flex-col sm:flex-row items-center justify-between gap-4">
                  <div class="text-xs text-slate-600">
                    <strong class="text-slate-900 font-semibold">Sovereign Direct Pathway:</strong> Zero agent markups • 100% direct university billing.
                  </div>
                  <a
                    href={post.data.moneyPageLink}
                    id="gtm-hub-spoke-conversion"
                    data-conversion-type="hub-spoke"
                    data-target-slug={slugPath}
                    class="inline-flex items-center gap-2 px-5 py-2.5 bg-slate-900 hover:bg-emerald-700 text-white font-bold text-xs uppercase tracking-wider rounded-xl transition-all shadow-sm shrink-0"
                  >
                    Access Sovereign Hub →
                  </a>
                </div>
              )}
            </section>
          )}

          {/* Render Markdown Document Content Nodes */}
          <div class="prose-content min-w-0">
            {Content ? <Content /> : <p class="text-slate-500 italic">Audit report content is loading...</p>}
          </div>

          {/* 🧠 Verified Reference Sources (Collapsible Accordion) */}
          <details class="group mt-14 bg-white border border-slate-200 rounded-2xl overflow-hidden font-sans shadow-sm transition-all duration-300">
            <summary class="flex items-center justify-between gap-3 p-4 cursor-pointer select-none hover:bg-slate-50 transition-colors list-none [&::-webkit-details-marker]:hidden">
              <div class="flex items-center gap-2.5">
                <svg aria-hidden="true" class="w-4 h-4 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                </svg>
                <span class="text-xs sm:text-sm font-bold text-slate-800">Verified Reference Sources & Statutory Citations</span>
                <span class="text-[10px] text-slate-500 font-mono uppercase tracking-wider hidden sm:inline">(E-E-A-T Compliance)</span>
              </div>
              <div class="flex items-center gap-1.5 text-xs text-slate-500 font-mono uppercase tracking-wider">
                <span class="group-open:hidden flex items-center gap-1">
                  View Sources
                  <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                  </svg>
                </span>
                <span class="hidden group-open:flex items-center gap-1">
                  Collapse
                  <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path>
                  </svg>
                </span>
              </div>
            </summary>
            
            <div class="px-5 pb-5 pt-3 border-t border-slate-100 bg-slate-50/50">
              <p class="text-slate-600 text-xs leading-relaxed mb-4">
                To satisfy stringent institutional due diligence and Google E-E-A-T standards, all figures, tuition rates, and legal frameworks in this investigation are cross-referenced with primary government registries:
              </p>
              <div class="grid grid-cols-1 gap-2.5">
                {references.map((ref) => (
                  <div class="p-3.5 rounded-xl bg-white border border-slate-200/80 flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-xs">
                    <div class="flex flex-col">
                      <span class="text-xs font-bold text-slate-900">{ref.name}</span>
                      <span class="text-[11px] text-slate-500 mt-0.5 leading-relaxed">{ref.description}</span>
                    </div>
                    <a 
                      href={ref.url} 
                      target="_blank" 
                      rel="noopener noreferrer" 
                      class="inline-flex items-center gap-1 shrink-0 text-[11px] font-mono font-bold uppercase tracking-wider text-emerald-700 hover:text-emerald-800"
                    >
                      Official Registry
                      <svg aria-hidden="true" class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                      </svg>
                    </a>
                  </div>
                ))}
              </div>
            </div>
          </details>

          {/* Author Byline Card */}
          <div class="mt-14 bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/90 shadow-sm flex flex-col sm:flex-row gap-6 items-center sm:items-start font-sans">
            <div class="flex-shrink-0">
              <div class="w-16 h-16 rounded-full flex items-center justify-center bg-emerald-100 border border-emerald-300 text-emerald-800 font-serif text-xl font-bold shadow-xs">
                {authorInitials}
              </div>
            </div>

            <div class="flex-1 text-center sm:text-left">
              <span class="text-[10px] uppercase tracking-widest text-emerald-700 font-bold block mb-1 font-mono">
                Audited & Published By
              </span>
              <div class="flex flex-col sm:flex-row sm:items-baseline gap-2 mb-2">
                <h4 class="text-xl font-serif text-slate-900 font-medium">
                  {post.data.author || 'Mr. Jayant Patil'}
                </h4>
                <span class="text-slate-300 hidden sm:inline">|</span>
