---
// src/pages/review-qr.astro
// 👑 OFFICIAL GOOGLE-BRANDED ULTRA-PREMIUM SMART REVIEW QR CODE & DESK STANDEE
// Designed for Finesse Overseas Education • Rajarampuri, Kolhapur
import QRCode from 'qrcode';
import '../styles/global.css';

const REVIEW_URL = 'https://finesseoverseas.com/review';

// Server-side generation of high-res vector QR code (Level H = 30% redundancy)
const baseQrSvg = await QRCode.toString(REVIEW_URL, {
  type: 'svg',
  errorCorrectionLevel: 'H',
  margin: 1,
  color: {
    dark: '#1e293b',
    light: '#ffffff'
  }
});
---

<!doctype html>
<html lang="en" class="h-full bg-slate-100">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Google Review Smart QR Code & Standee • Finesse Overseas Education</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    
    <style is:global>
      @media print {
        body {
          background: white !important;
          padding: 0 !important;
          margin: 0 !important;
        }
        .no-print {
          display: none !important;
        }
        .print-card-container {
          box-shadow: none !important;
          border: none !important;
          margin: 0 auto !important;
          padding: 0 !important;
          width: 100% !important;
          max-width: 148mm !important; /* A5 standard width */
        }
        .stand-base {
          display: none !important;
        }
        * {
          -webkit-print-color-adjust: exact !important;
          print-color-adjust: exact !important;
        }
      }
    </style>
  </head>

  <body class="min-h-screen bg-slate-100 font-sans text-slate-800 antialiased flex flex-col justify-between">
    
    <!-- 🔝 TOP CONTROL BAR (HIDDEN IN PRINT) -->
    <header class="no-print bg-white border-b border-slate-200 px-4 py-3 sticky top-0 z-30 shadow-xs">
      <div class="max-w-5xl mx-auto flex flex-wrap items-center justify-between gap-3">
        
        <!-- Left: Branding & Back link -->
        <div class="flex items-center gap-3">
          <a href="/review" class="flex items-center gap-1.5 text-xs font-semibold text-slate-600 hover:text-[#1a73e8] transition-colors bg-slate-100 hover:bg-blue-50 px-2.5 py-1.5 rounded-lg border border-slate-200">
            <span>←</span>
            <span>Back to Live Review</span>
          </a>
          <div class="h-4 w-[1px] bg-slate-200 hidden sm:block"></div>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span class="text-xs font-bold text-slate-900">Google Smart QR Plaque Generator</span>
          </div>
        </div>

        <!-- Center: Format Switcher Tabs -->
        <div class="flex items-center bg-slate-100 p-1 rounded-xl border border-slate-200 text-xs font-medium">
          <button type="button" id="tab-standee" class="format-tab px-3 py-1 rounded-lg bg-white shadow-xs text-slate-900 font-bold transition-all cursor-pointer">
            Desk Standee (A5)
          </button>
          <button type="button" id="tab-sticker" class="format-tab px-3 py-1 rounded-lg text-slate-600 hover:text-slate-900 transition-all cursor-pointer">
            Door Sticker (Square)
          </button>
          <button type="button" id="tab-card" class="format-tab px-3 py-1 rounded-lg text-slate-600 hover:text-slate-900 transition-all cursor-pointer">
            Counselor Card (A6)
          </button>
        </div>

        <!-- Right: Action Buttons -->
        <div class="flex items-center gap-2">
          <button 
            type="button" 
            id="print-btn" 
            class="px-3.5 py-1.5 rounded-xl bg-[#1a73e8] hover:bg-[#1557b0] text-white text-xs font-bold shadow-xs hover:shadow-md transition-all flex items-center gap-1.5 cursor-pointer"
          >
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M19 8H5c-1.66 0-3 1.34-3 3v6h4v4h12v-4h4v-6c0-1.66-1.34-3-3-3zm-3 11H8v-5h8v5zm3-7c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm-1-9H6v4h12V3z"/></svg>
            <span>Print Standee</span>
          </button>

          <button 
            type="button" 
            id="download-png-btn" 
            class="px-3 py-1.5 rounded-xl bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold border border-slate-300 transition-all flex items-center gap-1.5 cursor-pointer shadow-xs"
          >
            <svg class="w-3.5 h-3.5 fill-current text-slate-500" viewBox="0 0 24 24"><path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM17 13l-5 5-5-5h3V9h4v4h3z"/></svg>
            <span>Save PNG</span>
          </button>
        </div>

      </div>
    </header>

    <!-- 🌟 MAIN CONTENT AREA -->
    <main class="flex-1 flex flex-col items-center justify-center p-4 sm:p-8">
      
      <!-- 🎴 PRINT-READY PLAQUE CONTAINER -->
      <div class="print-card-container relative flex flex-col items-center">
        
        <!-- ACRYLIC PLAQUE BODY -->
        <div 
          id="plaque-card" 
          class="w-full max-w-[360px] bg-white rounded-3xl p-7 border-2 border-slate-200/90 shadow-2xl relative overflow-hidden transition-all duration-300 flex flex-col items-center text-center"
        >
          
          <!-- Subtle 4-Color Google Signature Top Accent Bar -->
          <div class="absolute top-0 left-0 right-0 h-1.5 flex">
            <div class="w-1/4 h-full bg-[#4285F4]"></div>
            <div class="w-1/4 h-full bg-[#EA4335]"></div>
            <div class="w-1/4 h-full bg-[#FBBC05]"></div>
            <div class="w-1/4 h-full bg-[#34A853]"></div>
          </div>

          <!-- 1. Google Official Logo & Verified Badge -->
          <div class="flex flex-col items-center mt-2 mb-3">
            <div class="flex items-center gap-2 mb-1.5">
              <!-- Official Original Google Logo -->
              <img src="/images/google-logo.svg" alt="Google" class="h-7 w-auto object-contain shrink-0" />
              <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Reviews</span>
            </div>
            
            <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-blue-50 border border-blue-200/60 text-[11px] font-semibold text-[#1a73e8]">
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
              <span>Verified Google Business</span>
            </div>
          </div>

          <!-- 2. Primary Headline & 5 Stars -->
          <h1 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight leading-tight">
            Review us on Google
          </h1>
          <p class="text-xs text-slate-500 mt-0.5">Help aspiring students find genuine guidance</p>

          <!-- 5 Large Gold Google Stars -->
          <div class="flex items-center justify-center gap-1 my-2.5 text-[#fbbc04]">
            <svg class="w-7 h-7 fill-current drop-shadow-xs" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
            <svg class="w-7 h-7 fill-current drop-shadow-xs" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
            <svg class="w-7 h-7 fill-current drop-shadow-xs" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
            <svg class="w-7 h-7 fill-current drop-shadow-xs" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
            <svg class="w-7 h-7 fill-current drop-shadow-xs" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
          </div>

          <!-- 3. SMART QR CODE FRAME (WITH GOOGLE CENTER EMBLEM) -->
          <div class="relative my-2 p-3 bg-white rounded-2xl border border-slate-200/90 shadow-md flex items-center justify-center">
            
            <!-- Google 4-color subtle corner markers -->
            <div class="absolute -top-1 -left-1 w-3 h-3 border-t-2 border-l-2 border-[#4285F4] rounded-tl-md"></div>
            <div class="absolute -top-1 -right-1 w-3 h-3 border-t-2 border-r-2 border-[#EA4335] rounded-tr-md"></div>
            <div class="absolute -bottom-1 -left-1 w-3 h-3 border-b-2 border-l-2 border-[#34A853] rounded-bl-md"></div>
            <div class="absolute -bottom-1 -right-1 w-3 h-3 border-b-2 border-r-2 border-[#FBBC05] rounded-br-md"></div>

            <!-- Client-side Styled QR Container (falls back to SSR SVG) -->
            <div id="styled-qr-container" class="w-[210px] h-[210px] relative flex items-center justify-center">
              
              <!-- SSR Vector QR Code (instant render) -->
              <div id="fallback-qr" class="w-full h-full flex items-center justify-center">
                <Fragment set:html={baseQrSvg} />
              </div>

              <!-- Center Google Multicolor Emblem (Embedded on top with clean white backing) -->
              <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-11 h-11 bg-white rounded-full p-1.5 shadow-md border border-slate-100 flex items-center justify-center z-10 pointer-events-none">
                <img src="/images/google-g.svg" alt="Google G" class="w-7 h-7 object-contain" />
              </div>

            </div>
          </div>

          <!-- 4. Smart Scan / Tap Callout (NFC Badge) -->
          <div class="flex items-center gap-2 mt-2 px-3 py-1.5 rounded-full bg-slate-50 border border-slate-200">
            <!-- Contactless Waves SVG -->
            <svg class="w-4 h-4 text-[#1a73e8]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12.55a11 11 0 0 1 14.08 0"/>
              <path d="M1.42 9a16 16 0 0 1 21.16 0"/>
              <path d="M8.53 16.11a6 6 0 0 1 6.95 0"/>
              <line x1="12" y1="20" x2="12.01" y2="20"/>
            </svg>
            <span class="text-xs font-bold text-slate-800">Scan with Camera or Tap Phone</span>
          </div>

          <p class="text-[11px] text-slate-500 mt-1">
            ⚡ Auto-generates your unique review in 10 seconds
          </p>

          <!-- 5. Business Identity Footer -->
          <div class="mt-4 pt-3 border-t border-slate-100 w-full flex items-center justify-between text-left">
            <div class="flex items-center gap-2">
              <img src="/favicon.png" alt="Finesse Logo" class="w-6 h-6 object-contain" />
              <div>
                <p class="text-xs font-bold text-slate-900 leading-tight">Finesse Overseas Education</p>
                <p class="text-[10px] text-slate-500">4th Lane, Rajarampuri, Kolhapur</p>
              </div>
            </div>
            <div class="text-right">
              <span class="text-[10px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200">
                4.7 ★★★★★
              </span>
            </div>
          </div>

        </div>

        <!-- 🪵 REALISTIC ACRYLIC DESK WOODEN STAND BASE (DISPLAY ONLY, HIDDEN IN PRINT) -->
        <div id="wooden-base" class="stand-base no-print w-[380px] h-6 bg-gradient-to-r from-amber-800 via-amber-700 to-amber-900 rounded-b-xl shadow-xl mt-[-6px] border-t border-amber-950 flex items-center justify-center">
          <div class="w-2/3 h-1 bg-amber-950/40 rounded-full"></div>
        </div>

      </div>

      <!-- 💡 INSTRUCTIONS & PRINTING TIPS (HIDDEN IN PRINT) -->
      <div class="no-print max-w-xl mx-auto mt-8 bg-white rounded-2xl p-5 border border-slate-200 shadow-sm text-xs text-slate-600 space-y-3">
        <h2 class="font-bold text-slate-900 text-sm flex items-center gap-1.5">
          <span>💡</span> Printing & Reception Desk Setup Guide:
        </h2>
        <ul class="space-y-1.5 list-disc pl-4 text-slate-600">
          <li><strong>Desk Standee (Acrylic Plaque):</strong> Click <em>Print Standee</em> and select <strong>Paper Size: A5</strong> or <strong>A6</strong>. Place inside a clear acrylic T-stand on Jayant sir's desk, counseling cabins, and the main reception counter.</li>
          <li><strong>Door / Glass Sticker:</strong> Switch to <em>Door Sticker</em> tab, print on transparent vinyl or sticker sheet, and affix to the office entrance glass door at 4th Lane, Rajarampuri.</li>
          <li><strong>Zero Friction for Students:</strong> Any smartphone camera (Android or iOS) detects this QR code instantly from up to 3 feet distance and opens the review booster funnel without any app downloads.</li>
        </ul>
      </div>

    </main>

    <!-- 🦶 FOOTER (HIDDEN IN PRINT) -->
    <footer class="no-print py-4 border-t border-slate-200 text-center text-xs text-slate-500">
      Finesse Overseas Education • Rajarampuri, Kolhapur • Direct Review Link: 
      <a href="/review" class="text-[#1a73e8] underline font-medium" target="_blank">finesseoverseas.com/review</a>
    </footer>

    <!-- 🧠 CLIENT LOGIC: QR CODE STYLING & INTERACTION -->
    <script>
      import QRCodeStyling from 'qr-code-styling';

      // Initialize Google-Styled Smart QR Code
      const qrContainer = document.getElementById('styled-qr-container');
      const fallbackQr = document.getElementById('fallback-qr');

      if (qrContainer) {
        try {
          const qrCode = new QRCodeStyling({
            width: 210,
            height: 210,
            type: 'svg',
            data: 'https://finesseoverseas.com/review',
            margin: 4,
            qrOptions: {
              typeNumber: 0,
              mode: 'Byte',
              errorCorrectionLevel: 'H'
            },
            dotsOptions: {
              color: '#202124',
              type: 'rounded' // Smooth modern Google dots
            },
            cornersSquareOptions: {
              type: 'extra-rounded',
              color: '#1a73e8' // Google Blue Finder Eyes
            },
            cornersDotOptions: {
              type: 'dot',
              color: '#ea4335' // Google Red Finder Dots
            },
            backgroundOptions: {
              color: '#ffffff'
            }
          });

          // Append styled QR and remove fallback
          if (fallbackQr) fallbackQr.remove();
          qrCode.append(qrContainer);

          // Save PNG handler
          const downloadBtn = document.getElementById('download-png-btn');
          if (downloadBtn) {
            downloadBtn.addEventListener('click', () => {
              qrCode.download({
                name: 'finesse-google-review-smart-qr',
                extension: 'png'
              });
            });
          }
        } catch (e) {
          console.warn('QRCodeStyling fallback to SSR SVG:', e);
        }
      }

      // Print Button Trigger
      const printBtn = document.getElementById('print-btn');
      if (printBtn) {
        printBtn.addEventListener('click', () => {
          window.print();
        });
      }

      // Format Switcher Tabs
      const tabStandee = document.getElementById('tab-standee');
      const tabSticker = document.getElementById('tab-sticker');
      const tabCard = document.getElementById('tab-card');
      const plaqueCard = document.getElementById('plaque-card');
      const woodenBase = document.getElementById('wooden-base');

      function setActiveTab(activeBtn: HTMLElement) {
        [tabStandee, tabSticker, tabCard].forEach(btn => {
          if (btn) {
            btn.classList.remove('bg-white', 'shadow-xs', 'text-slate-900', 'font-bold');
            btn.classList.add('text-slate-600');
          }
        });
        activeBtn.classList.remove('text-slate-600');
        activeBtn.classList.add('bg-white', 'shadow-xs', 'text-slate-900', 'font-bold');
      }

      if (tabStandee && plaqueCard && woodenBase) {
        tabStandee.addEventListener('click', () => {
          setActiveTab(tabStandee);
          plaqueCard.className = 'w-full max-w-[360px] bg-white rounded-3xl p-7 border-2 border-slate-200/90 shadow-2xl relative overflow-hidden transition-all duration-300 flex flex-col items-center text-center';
          woodenBase.classList.remove('hidden');
        });
      }

      if (tabSticker && plaqueCard && woodenBase) {
        tabSticker.addEventListener('click', () => {
          setActiveTab(tabSticker);
          plaqueCard.className = 'w-full max-w-[340px] aspect-square bg-white rounded-2xl p-6 border-4 border-[#1a73e8] shadow-xl relative overflow-hidden transition-all duration-300 flex flex-col items-center justify-between text-center';
          woodenBase.classList.add('hidden');
        });
      }

      if (tabCard && plaqueCard && woodenBase) {
        tabCard.addEventListener('click', () => {
          setActiveTab(tabCard);
          plaqueCard.className = 'w-full max-w-[300px] bg-white rounded-2xl p-5 border border-slate-300 shadow-lg relative overflow-hidden transition-all duration-300 flex flex-col items-center text-center';
          woodenBase.classList.add('hidden');
        });
      }
    </script>

  </body>
</html>
