<!DOCTYPE html>
<html lang="en">
<head>
<!--[if gte mso 9]>
<xml>
 <w:WordDocument>
  <w:View>Print</w:View>
  <w:Zoom>100</w:Zoom>
  <w:DoNotOptimizeForBrowser/>
 </w:WordDocument>
</xml>
<![endif]-->
  <meta charset="UTF-8">
  <title>Enquiry Form | Finesse Overseas Education</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
  <style>
    @page {
      size: A4 portrait;
      margin: 14mm 16mm 14mm 16mm;
    }
    
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }

    html, body {
      height: 100%;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      color: #0f172a;
      background-color: #ffffff;
      font-size: 10.5pt;
      line-height: 1.4;
    }

    .page-container {
      height: 100%;
      min-height: 268mm;
      max-height: 269mm;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    /* HEADER */
    .header-table {
      width: 100%;
      border-bottom: 2.5px solid #0f766e;
      padding-bottom: 12px;
      margin-bottom: 6px;
    }

    .logo-img {
      height: 52px;
      width: auto;
      object-fit: contain;
    }

    .header-title-box {
      text-align: center;
    }

    .form-main-title {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 18pt;
      font-weight: 800;
      color: #0f172a;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      line-height: 1.1;
    }

    .form-sub-title {
      font-size: 8.5pt;
      font-weight: 700;
      color: #0d9488;
      letter-spacing: 2px;
      text-transform: uppercase;
      margin-top: 3px;
    }

    .date-box {
      text-align: right;
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 10.5pt;
      font-weight: 700;
      color: #1e293b;
    }

    .date-line {
      display: inline-block;
      border-bottom: 1.8px solid #0f172a;
      width: 120px;
      height: 20px;
      vertical-align: bottom;
      margin-left: 6px;
    }

    /* FORM FIELDS LIST */
    .fields-list {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      flex: 1;
      padding-top: 10px;
      padding-bottom: 10px;
      gap: 16px;
    }

    .field-row {
      display: flex;
      align-items: flex-end;
      width: 100%;
      gap: 16px;
    }

    .field-col {
      display: flex;
      align-items: flex-end;
      flex: 1;
    }

    .label {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-weight: 700;
      font-size: 10.5pt;
      color: #0f172a;
      white-space: nowrap;
      margin-right: 8px;
      letter-spacing: 0.2px;
    }

    .line {
      flex: 1;
      border-bottom: 1.5px dotted #64748b;
      height: 24px;
      margin-bottom: 2px;
    }

    /* OFFICE USE ONLY BOX */
    .office-box {
      border: 1.8px solid #0f766e;
      border-radius: 8px;
      background: #f8fafc;
      padding: 12px 16px;
      margin-top: 6px;
      margin-bottom: 8px;
    }

    .office-title {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 9.5pt;
      font-weight: 800;
      color: #0f766e;
      text-transform: uppercase;
      letter-spacing: 1.2px;
      border-bottom: 1.2px solid #cbd5e1;
      padding-bottom: 5px;
      margin-bottom: 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .office-fields {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    /* FOOTER BAR */
    .footer-bar {
      border-top: 1.8px solid #0f766e;
      padding-top: 8px;
      font-size: 8pt;
      color: #475569;
      display: flex;
      justify-content: space-between;
      align-items: center;
      line-height: 1.4;
    }

    .footer-brand {
      font-weight: 800;
      color: #0f766e;
    }

    .contact-badge {
      font-weight: 700;
      color: #0f172a;
    }
  </style>
</head>
<body>

<div class="page-container">

  <!-- TOP HEADER -->
  <table class="header-table">
    <tr>
      <td style="width: 32%; vertical-align: middle;">
        <img src="data:image/png;base64," alt="Finesse Overseas Education" class="logo-img">
      </td>
      <td style="width: 44%; vertical-align: middle;" class="header-title-box">
        <div class="form-main-title">Enquiry Form</div>
        <div class="form-sub-title">Finesse Overseas Education</div>
      </td>
      <td style="width: 24%; vertical-align: middle;" class="date-box">
        <span>Date:</span><span class="date-line"></span>
      </td>
    </tr>
  </table>

  <!-- EXACT 13 FIELDS EVENLY BALANCED ACROSS FULL A4 PAGE -->
  <div class="fields-list">

    <!-- 1. Name -->
    <div class="field-row">
      <div class="field-col">
        <span class="label">Name:</span>
        <div class="line"></div>
      </div>
    </div>

    <!-- 2. Location -->
    <div class="field-row">
      <div class="field-col">
        <span class="label">Location:</span>
        <div class="line"></div>
      </div>
    </div>

    <!-- 3. Mobile No. & Whatsup No. -->
    <div class="field-row">
      <div class="field-col" style="flex: 1.15;">
        <span class="label">Mobile No.:</span>
        <div class="line"></div>
      </div>
      <div class="field-col" style="flex: 1;">
        <span class="label">WhatsApp No.:</span>
        <div class="line"></div>
      </div>
    </div>

    <!-- 4. Father's Mob. No. & Mother's Mob No. -->
    <div class="field-row">
      <div class="field-col" style="flex: 1.15;">
        <span class="label">Father's Mob. No.:</span>
        <div class="line"></div>
      </div>
      <div class="field-col" style="flex: 1;">
        <span class="label">Mother's Mob No.:</span>
        <div class="line"></div>
      </div>
    </div>

    <!-- 5. Email -->
    <div class="field-row">
      <div class="field-col">
        <span class="label">Email:</span>
        <div class="line"></div>
      </div>
    </div>

    <!-- 6. Qualification -->
    <div class="field-row">
      <div class="field-col">
        <span class="label">Qualification:</span>
        <div class="line"></div>
      </div>
    </div>

    <!-- 7. Interested in Bachelor/ Master in -->
    <div class="field-row">
      <div class="field-col">
        <span class="label">Interested in Bachelor/ Master in:</span>
        <div class="line"></div>
      </div>
    </div>

    <!-- 8. Course -->
    <div class="field-row">
      <div class="field-col">
        <span class="label">Course:</span>
        <div class="line"></div>
      </div>
    </div>

    <!-- 9. Intake -->
    <div class="field-row">
      <div class="field-col">
        <span class="label">Intake:</span>
        <div class="line"></div>
      </div>
    </div>

    <!-- 10. Country Interested -->
    <div class="field-row">
      <div class="field-col">
        <span class="label">Country Interested:</span>
        <div class="line"></div>
      </div>
    </div>

    <!-- 11. Budget -->
    <div class="field-row">
      <div class="field-col">
        <span class="label">Budget:</span>
        <div class="line"></div>
      </div>
    </div>

    <!-- 12. Finance- self / Educational Loan -->
    <div class="field-row">
      <div class="field-col">
        <span class="label">Finance- self / Educational Loan:</span>
        <div class="line"></div>
      </div>
    </div>

    <!-- 13. How do you know about us -->
    <div class="field-row">
      <div class="field-col">
        <span class="label">How do you know about us:</span>
        <div class="line"></div>
      </div>
    </div>

  </div>

  <!-- FOR OFFICE USE (SPACIOUS & BALANCED) -->
  <div class="office-box">
    <div class="office-title">
      <span>For Office Use</span>
      <span style="font-size: 8pt; font-weight: 600; color: #64748b; text-transform: none;">Counseling Record</span>
    </div>
    <div class="office-fields">
      <div class="field-row">
        <div class="field-col" style="flex: 1.2;">
          <span class="label" style="color: #0f766e;">Attended by:</span>
          <div class="line" style="border-color: #0f766e;"></div>
        </div>
        <div class="field-col" style="flex: 1;">
          <span class="label" style="color: #0f766e;">Signature:</span>
          <div class="line" style="border-color: #0f766e;"></div>
        </div>
      </div>
      <div class="field-row">
        <div class="field-col">
          <span class="label" style="color: #0f766e;">Remark:</span>
          <div class="line" style="border-color: #0f766e;"></div>
        </div>
      </div>
      <div class="field-row">
        <div class="field-col">
          <span class="label" style="color: transparent; width: 60px;"></span>
          <div class="line" style="border-color: #0f766e;"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- CORPORATE FOOTER -->
  <div class="footer-bar">
    <div>
      <span class="footer-brand">FINESSE OVERSEAS EDUCATION</span> | Samarth Sakshi Plaza, 1st Floor, 4th Lane, Rajarampuri, Kolhapur - 416008
    </div>
    <div>
      📞 <span class="contact-badge">+91-9850069600</span> | 🌐 <span class="contact-badge">finesseoverseas.com</span>
    </div>
  </div>

</div>

</body>
</html>